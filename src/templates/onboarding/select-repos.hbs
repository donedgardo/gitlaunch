<!-- Navigation -->
<nav class="fixed w-full bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm border-b border-gray-200 dark:border-gray-800 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center">
      <div class="flex items-center">
        <span class="text-xl font-bold text-gray-900 dark:text-white">GitLaunch</span>
      </div>
      <div class="flex items-center">
        <span class="text-sm text-gray-500 dark:text-gray-400">Setting up your account</span>
      </div>
    </div>
  </div>
</nav>

<!-- Main Content -->
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pt-16">
  <div class="max-w-2xl mx-auto px-4 py-16 sm:py-24">
    <!-- Progress Steps -->
    <div class="mb-12">
      <div style="display: flex; align-items: center; justify-content: center;">
        <div style="display: flex; align-items: center;">
          <!-- Step 1: Complete -->
          <div style="display: flex; flex-direction: column; align-items: center;">
            <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;" class="bg-green-500 rounded-full text-white">
              <svg style="width: 24px; height: 24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <span class="mt-2 text-sm text-green-600 dark:text-green-400">Connect</span>
          </div>

          <div style="width: 80px; height: 4px;" class="bg-green-500 mx-4"></div>

          <!-- Step 2: Current -->
          <div style="display: flex; flex-direction: column; align-items: center;">
            <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;" class="bg-blue-600 rounded-full text-white font-semibold shadow-lg shadow-blue-600/25">
              2
            </div>
            <span class="mt-2 text-sm font-medium text-blue-600">Select Repos</span>
          </div>

          <div style="width: 80px; height: 4px;" class="bg-gray-200 dark:bg-gray-700 mx-4"></div>

          <!-- Step 3: Pending -->
          <div style="display: flex; flex-direction: column; align-items: center;">
            <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;" class="bg-gray-200 dark:bg-gray-700 rounded-full text-gray-500 dark:text-gray-400 font-semibold">
              3
            </div>
            <span class="mt-2 text-sm text-gray-500 dark:text-gray-400">Deploy</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Header -->
    <div class="text-center mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">
        Select Repositories
      </h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
        Choose which repositories you want to manage with GitLaunch.
      </p>
    </div>

    <!-- Plan Limits Notice -->
    <div id="plan-limits" class="mb-6 p-4 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center">
          <span class="text-sm text-gray-600 dark:text-gray-400">
            <span class="font-medium text-gray-900 dark:text-white capitalize">{{plan}}</span> plan:
            You can select up to <span id="max-repos" class="font-semibold text-blue-600">{{maxRepositories}}</span> {{#if (eq maxRepositories 1)}}repository{{else}}repositories{{/if}}
          </span>
        </div>
        {{#unless privateReposAllowed}}
          <span id="public-only-notice" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400">
            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
            </svg>
            Public repos only
          </span>
        {{/unless}}
      </div>
      {{#unless privateReposAllowed}}
        <p class="mt-2 text-xs text-gray-500 dark:text-gray-500">
          <a href="/settings/billing" class="text-blue-600 hover:underline">Upgrade to a paid plan</a> to use private repositories.
        </p>
      {{/unless}}
    </div>

    {{#if error}}
      <!-- Error Message -->
      <div id="plan-error" class="mb-6 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl">
        <div class="flex">
          <svg class="w-5 h-5 text-red-600 dark:text-red-400 mt-0.5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <p class="text-sm text-red-800 dark:text-red-200">{{error}}</p>
        </div>
      </div>
    {{/if}}

    <!-- Card -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden">
      <form action="/onboarding/repositories" method="POST">
        {{#if returnTo}}
        <input type="hidden" name="returnTo" value="{{returnTo}}" />
        {{/if}}
        <div class="p-8 sm:p-10">
          {{#if repositories.length}}
            <!-- Repository List -->
            <div class="space-y-3 max-h-96 overflow-y-auto pr-2">
              {{#each repositories}}
                <label class="flex items-center p-4 border border-gray-200 dark:border-gray-700 rounded-xl hover:border-blue-300 dark:hover:border-blue-600 hover:bg-blue-50/50 dark:hover:bg-blue-900/20 cursor-pointer transition-all group">
                  <input
                    type="checkbox"
                    name="repositories"
                    value="{{this.id}}"
                    class="w-5 h-5 text-blue-600 rounded border-gray-300 focus:ring-blue-500 focus:ring-offset-0"
                  />
                  <div class="ml-4 flex-1 min-w-0">
                    <div style="display: flex; align-items: center;">
                      <svg style="width: 20px; height: 20px; min-width: 20px;" class="text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
                      </svg>
                      <span class="text-gray-900 dark:text-white font-medium truncate">{{this.full_name}}</span>
                      {{#if this.private}}
                        <span class="ml-2 px-2 py-0.5 text-xs bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 rounded-full flex-shrink-0">
                          Private
                        </span>
                      {{/if}}
                    </div>
                  </div>
                </label>
              {{/each}}
            </div>

            <!-- Info Box -->
            <div class="mt-6 p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl">
              <div style="display: flex;">
                <svg style="width: 20px; height: 20px; min-width: 20px;" class="text-blue-600 dark:text-blue-400 mt-0.5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div class="text-sm text-blue-800 dark:text-blue-200">
                  <p>Don't see your repository?</p>
                  <a
                    href="https://github.com/settings/installations/{{githubInstallationId}}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center mt-1 text-blue-600 dark:text-blue-400 hover:underline font-medium"
                  >
                    <svg style="width: 16px; height: 16px;" class="mr-1" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                    Configure GitHub App access
                  </a>
                </div>
              </div>
            </div>
          {{else}}
            <!-- Empty State -->
            <div class="text-center py-12">
              <div style="width: 64px; height: 64px; display: flex; align-items: center; justify-content: center;" class="bg-gray-100 dark:bg-gray-700 rounded-full mx-auto mb-4">
                <svg style="width: 32px; height: 32px;" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
                </svg>
              </div>
              <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">No repositories found</h3>
              <p class="text-gray-600 dark:text-gray-400 max-w-sm mx-auto">
                Make sure you've granted GitLaunch access to the repositories you want to deploy.
              </p>
              <a
                href="https://github.com/settings/installations/{{githubInstallationId}}"
                target="_blank"
                rel="noopener noreferrer"
                style="display: inline-flex; align-items: center;"
                class="mt-6 text-blue-600 hover:text-blue-700 font-medium"
              >
                <svg style="width: 20px; height: 20px; min-width: 20px;" class="mr-2" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                Configure GitHub App access
              </a>
            </div>
          {{/if}}
        </div>

        <!-- Footer Actions -->
        <div class="px-8 sm:px-10 py-6 bg-gray-50 dark:bg-gray-800/50 border-t border-gray-200 dark:border-gray-700">
          <div class="flex flex-col sm:flex-row gap-4">
            <button
              type="submit"
              class="flex-1 px-6 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors shadow-lg shadow-blue-600/25"
            >
              Continue
            </button>
            <a
              href="{{#if returnTo}}{{returnTo}}{{else}}/dashboard{{/if}}"
              class="flex-1 px-6 py-3 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-semibold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors text-center"
            >
              {{#if returnTo}}Cancel{{else}}Skip for now{{/if}}
            </a>
          </div>
        </div>
      </form>
    </div>

    <!-- Help Link -->
    <p class="mt-8 text-center text-sm text-gray-500 dark:text-gray-500">
      You can always add more repositories later in <a href="/settings" class="text-blue-600 hover:underline">settings</a>
    </p>
  </div>
</div>
