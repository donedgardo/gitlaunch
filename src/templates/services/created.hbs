<!-- Hidden SSE listener for auto-redirect when build is created -->
<div
  id="build-listener"
  hx-ext="sse"
  sse-connect="/build-created-stream/{{serviceId}}"
  sse-swap="build:created"
  hx-swap="outerHTML"
></div>

<div class="max-w-2xl mx-auto px-4 py-16">
  <!-- Success Header -->
  <div class="text-center mb-10">
    <div style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;" class="bg-green-100 dark:bg-green-900/30 rounded-full mx-auto mb-6">
      <svg style="width: 40px; height: 40px;" class="text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">
      Service Created!
    </h1>
    <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
      <span class="font-semibold text-gray-900 dark:text-white">{{serviceName}}</span> is ready. Now let's set up your CI pipeline.
    </p>
  </div>

  <!-- API Key Section - Security Warning -->
  <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-2xl p-6 mb-6">
    <div style="display: flex; align-items: flex-start;">
      <svg style="width: 24px; height: 24px; min-width: 24px;" class="text-amber-600 dark:text-amber-400 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
      <div>
        <h3 class="font-semibold text-amber-800 dark:text-amber-200 mb-1">Save Your API Key Now</h3>
        <p class="text-sm text-amber-700 dark:text-amber-300">
          This key will only be shown once. Copy it and store it securely.
        </p>
      </div>
    </div>
  </div>

  <!-- API Key Display -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
    <div class="p-6 sm:p-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white">
          Your API Key
        </h2>
        <span class="px-3 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-sm font-medium rounded-full">
          New
        </span>
      </div>
      <div class="relative">
        <div id="api-key" class="bg-gray-900 dark:bg-gray-950 rounded-xl p-4 font-mono text-sm text-green-400 break-all pr-12">
          {{apiKey}}
        </div>
        <button
          onclick="copyApiKey()"
          class="absolute top-3 right-3 p-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors"
          title="Copy API key"
        >
          <svg id="api-copy-icon" style="width: 20px; height: 20px;" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
          </svg>
          <svg id="api-check-icon" style="width: 20px; height: 20px; display: none;" class="text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Step 1: Add Secrets -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
    <div class="p-6 sm:p-8">
      <div style="display: flex; align-items: flex-start;">
        <div style="width: 32px; height: 32px; min-width: 32px; display: flex; align-items: center; justify-content: center;" class="bg-blue-600 text-white rounded-full font-semibold mr-4">
          1
        </div>
        <div style="flex: 1;">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
            Add Secrets to GitHub
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            Add these to your repository secrets and variables:
          </p>
          <div class="space-y-3">
            <div class="bg-gray-50 dark:bg-gray-700/50 rounded-xl p-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Repository Secret</span>
                <span class="px-2 py-0.5 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 text-xs font-medium rounded">Required</span>
              </div>
              <code class="text-sm text-blue-600 dark:text-blue-400 font-mono">GITLAUNCH_API_KEY</code>
              <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
                Paste the API key shown above
              </p>
            </div>
            <div class="bg-gray-50 dark:bg-gray-700/50 rounded-xl p-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Repository Variable</span>
                <span class="px-2 py-0.5 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 text-xs font-medium rounded">Required</span>
              </div>
              <code class="text-sm text-blue-600 dark:text-blue-400 font-mono">GITLAUNCH_SERVICE_ID</code>
              <div class="mt-2 bg-gray-900 dark:bg-gray-950 rounded-lg p-3 font-mono text-sm text-green-400 flex items-center justify-between">
                <span id="service-id">{{serviceId}}</span>
                <button
                  onclick="copyServiceId()"
                  class="p-1 hover:bg-gray-800 rounded transition-colors"
                  title="Copy service ID"
                >
                  <svg id="service-copy-icon" style="width: 16px; height: 16px;" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                  </svg>
                  <svg id="service-check-icon" style="width: 16px; height: 16px; display: none;" class="text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Step 2: Update CI Workflow -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
    <div class="p-6 sm:p-8">
      <div style="display: flex; align-items: flex-start;">
        <div style="width: 32px; height: 32px; min-width: 32px; display: flex; align-items: center; justify-content: center;" class="bg-blue-600 text-white rounded-full font-semibold mr-4">
          2
        </div>
        <div style="flex: 1;">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
            Update Your CI Workflow
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            Add this step to your GitHub Actions workflow:
          </p>
          <div class="relative">
            <div class="bg-gray-900 dark:bg-gray-950 rounded-xl p-4 font-mono text-sm text-green-400 overflow-x-auto">
              <pre><code>- name: Report build
  uses: donedgardo/build-reporter@v1
  with:
    api-key: $&#123;&#123; secrets.GITLAUNCH_API_KEY &#125;&#125;
    service-id: $&#123;&#123; vars.GITLAUNCH_SERVICE_ID &#125;&#125;
    action: report-build
    build-id: $&#123;&#123; github.sha &#125;&#125;</code></pre>
            </div>
            <button
              onclick="copyWorkflowCode()"
              class="absolute top-3 right-3 p-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors"
              title="Copy to clipboard"
            >
              <svg id="workflow-copy-icon" style="width: 20px; height: 20px;" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              <svg id="workflow-check-icon" style="width: 20px; height: 20px; display: none;" class="text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Step 3: Push a Commit -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
    <div class="p-6 sm:p-8">
      <div style="display: flex; align-items: flex-start;">
        <div style="width: 32px; height: 32px; min-width: 32px; display: flex; align-items: center; justify-content: center;" class="bg-blue-600 text-white rounded-full font-semibold mr-4">
          3
        </div>
        <div style="flex: 1;">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
            Push a Commit
          </h2>
          <p class="text-gray-600 dark:text-gray-400">
            Your builds will appear in the dashboard automatically once your CI workflow runs.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Continue to Dashboard -->
  <div class="text-center">
    <a
      href="/dashboard/{{serviceName}}"
      id="continue-dashboard"
      class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors shadow-lg shadow-blue-600/25"
    >
      Continue to Dashboard
      <svg style="width: 20px; height: 20px; min-width: 20px;" class="ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
      </svg>
    </a>
  </div>
</div>

<script>
function copyApiKey() {
  const apiKey = document.getElementById('api-key').textContent.trim();
  navigator.clipboard.writeText(apiKey).then(() => {
    const copyIcon = document.getElementById('api-copy-icon');
    const checkIcon = document.getElementById('api-check-icon');
    copyIcon.style.display = 'none';
    checkIcon.style.display = 'block';
    setTimeout(() => {
      copyIcon.style.display = 'block';
      checkIcon.style.display = 'none';
    }, 2000);
  });
}

function copyServiceId() {
  const serviceId = document.getElementById('service-id').textContent.trim();
  navigator.clipboard.writeText(serviceId).then(() => {
    const copyIcon = document.getElementById('service-copy-icon');
    const checkIcon = document.getElementById('service-check-icon');
    copyIcon.style.display = 'none';
    checkIcon.style.display = 'block';
    setTimeout(() => {
      copyIcon.style.display = 'block';
      checkIcon.style.display = 'none';
    }, 2000);
  });
}

function copyWorkflowCode() {
  const code = `- name: Report build
  uses: donedgardo/build-reporter@v1
  with:
    api-key: \${{ secrets.GITLAUNCH_API_KEY }}
    service-id: \${{ vars.GITLAUNCH_SERVICE_ID }}
    action: report-build
    build-id: \${{ github.sha }}`;
  navigator.clipboard.writeText(code).then(() => {
    const copyIcon = document.getElementById('workflow-copy-icon');
    const checkIcon = document.getElementById('workflow-check-icon');
    copyIcon.style.display = 'none';
    checkIcon.style.display = 'block';
    setTimeout(() => {
      copyIcon.style.display = 'block';
      checkIcon.style.display = 'none';
    }, 2000);
  });
}
</script>
