{{> navigation }}

<div class="max-w-3xl mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">GitHub</h1>
  <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">
    Connect the GitLaunch GitHub App to trigger GitHub Actions workflows from
    your repositories.
  </p>

  <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden">
    <div class="p-6">
      {{#if connection}}
      <!-- Connected state -->
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Connection</h2>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300">
          Connected
        </span>
      </div>
      <dl class="text-sm space-y-2 mb-6">
        <div class="flex justify-between">
          <dt class="text-gray-500 dark:text-gray-400">Installation ID</dt>
          <dd class="text-gray-900 dark:text-white font-mono">{{connection.installationId}}</dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-gray-500 dark:text-gray-400">Connected</dt>
          <dd class="text-gray-900 dark:text-white">{{connection.connectedAt}}</dd>
        </div>
      </dl>
      <button
        hx-delete="/settings/github"
        hx-target="body"
        hx-confirm="Disconnect GitHub? Services deploying via GitHub Actions will stop dispatching until you reconnect."
        class="px-4 py-2 bg-red-600 text-white font-medium rounded-lg hover:bg-red-700 transition-colors text-sm">
        Disconnect
      </button>
      <p class="mt-4 text-xs text-gray-500 dark:text-gray-400">
        To change which repositories are shared, manage the app on
        <a href="{{installUrl}}" class="text-blue-600 hover:underline">GitHub</a>.
      </p>
      {{else}}
      <!-- Disconnected state -->
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Connect GitHub</h2>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">
        The GitHub App isn't installed for this account yet.
      </p>
      <a
        href="{{installUrl}}"
        class="inline-flex items-center px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors text-sm">
        Install GitHub App
      </a>
      {{/if}}
    </div>
  </div>
</div>
