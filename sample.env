# Server
PUBLIC_URL="http://localhost:3050"
PORT=3050

# Database
MONGODB_URI="mongodb://localhost:27017"

# Session
COOKIE_SECRET_SIGNATURE=your-secret-key-here

# Encryption at rest for stored secrets (e.g. Jenkins API tokens).
# Each key must be 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
#
# Single key (simplest):
ENCRYPTION_KEY=
#
# To rotate keys without stranding existing ciphertexts, use a keyring instead:
# list every key as "<id>:<base64key>" (comma-separated) and name the current
# one. New data is encrypted with the primary; old keys stay for decryption.
# ENCRYPTION_KEYS=2026a:BASE64KEY_A,2026b:BASE64KEY_B
# ENCRYPTION_PRIMARY_KEY_ID=2026b

# Dev mode — use fake GitHub services (no real OAuth/App needed)
USE_FAKE_GITHUB=false

# Dev tool — show a "Simulate Build" button (onboarding, dashboard, setup) that
# reports a fake build so you can exercise the flow without a real CI pipeline.
ENABLE_BUILD_SIMULATION=false

# GitHub App (create at https://github.com/settings/apps/new)
GH_APP_ID=
GH_APP_CLIENT_ID=
GH_APP_CLIENT_SECRET=
GH_APP_WEBHOOK_SECRET=
# Use scripts/add-private-key.sh to add this from your .pem file
GH_APP_PRIVATE_KEY=
# GitHub App name (for install URL generation)
GH_APP_NAME=

# Stripe (for billing)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_TEAM_PRICE_ID=price_xxx

# Feature flags (optional): shared Redis cache for flag evaluation across
# instances. Leave blank to use an in-memory per-instance cache. Requires
# `yarn add ioredis` when set.
REDIS_URL=
