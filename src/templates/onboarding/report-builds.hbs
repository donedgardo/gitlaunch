<!-- Navigation -->
<nav class="fixed w-full bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm border-b border-gray-200 dark:border-gray-800 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center">
      <span class="text-xl font-bold text-gray-900 dark:text-white">GitLaunch</span>
      <span class="text-sm text-gray-500 dark:text-gray-400">Step 2 of 3 · Report builds</span>
    </div>
  </div>
</nav>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pt-16">
  <div class="max-w-3xl mx-auto px-4 py-12 sm:py-16">
    <div class="text-center mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">
        Report your first build
      </h1>
      <p class="mt-3 text-lg text-gray-600 dark:text-gray-400">
        Connect <span class="font-semibold">{{serviceName}}</span>'s CI to GitLaunch. Pick your tool below.
      </p>
    </div>

    <!-- Credentials -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm p-6 mb-6">
      <dl class="space-y-4 text-sm">
        <div>
          <dt class="text-gray-500 dark:text-gray-400 mb-1">Service ID</dt>
          <dd class="flex items-center gap-2">
            <code id="svc-id" class="font-mono text-gray-900 dark:text-white bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded">{{serviceId}}</code>
            <button onclick="copyText('svc-id')" class="text-xs text-blue-600 hover:underline">Copy</button>
          </dd>
        </div>
        {{#if apiKey}}
        <div>
          <dt class="text-gray-500 dark:text-gray-400 mb-1">API Key <span class="text-amber-600 dark:text-amber-400">(shown once — save it now)</span></dt>
          <dd class="flex items-center gap-2">
            <code id="api-key" class="font-mono text-gray-900 dark:text-white bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded break-all">{{apiKey}}</code>
            <button onclick="copyText('api-key')" class="text-xs text-blue-600 hover:underline">Copy</button>
          </dd>
        </div>
        {{/if}}
      </dl>
    </div>

    <!-- Provider tabs -->
    <div class="flex mb-6 bg-gray-100 dark:bg-gray-700 rounded-lg p-1">
      <button id="rt_tab_github" onclick="switchReportTab('github')" class="flex-1 px-3 py-2 text-sm font-medium rounded-md bg-white dark:bg-gray-600 text-gray-900 dark:text-white shadow-sm">GitHub Actions</button>
      <button id="rt_tab_jenkins" onclick="switchReportTab('jenkins')" class="flex-1 px-3 py-2 text-sm font-medium rounded-md text-gray-500 dark:text-gray-400">Jenkins</button>
      <button id="rt_tab_raw" onclick="switchReportTab('raw')" class="flex-1 px-3 py-2 text-sm font-medium rounded-md text-gray-500 dark:text-gray-400">Raw / curl</button>
    </div>

    <div id="rt_panel_github">
      {{> githubSecretsSetup serviceId=serviceId idPrefix="ob_" showApiKeyNote=true showCopyButton=true}}
      {{> buildReportingInstructions idPrefix="ob_"}}
    </div>

    <div id="rt_panel_jenkins" style="display: none;">
      {{> jenkinsBuildReportingGuide apiUrl=apiUrl serviceId=serviceId}}
    </div>

    <div id="rt_panel_raw" style="display: none;">
      <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg p-6 sm:p-8 mb-6">
        {{> rawBuildReportingGuide apiUrl=apiUrl serviceId=serviceId apiKey=apiKey}}
      </div>
    </div>

    <!-- Waiting indicator -->
    <div class="text-center mt-8">
      <div class="inline-flex items-center gap-3 px-5 py-3 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl">
        <svg class="animate-spin w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
        <span class="text-sm text-blue-800 dark:text-blue-200">Waiting for your first build report…</span>
      </div>
    </div>
  </div>
</div>

<script>
function switchReportTab(tab) {
  var tabs = ['github', 'jenkins', 'raw'];
  var active = 'flex-1 px-3 py-2 text-sm font-medium rounded-md bg-white dark:bg-gray-600 text-gray-900 dark:text-white shadow-sm';
  var idle = 'flex-1 px-3 py-2 text-sm font-medium rounded-md text-gray-500 dark:text-gray-400';
  tabs.forEach(function (t) {
    document.getElementById('rt_panel_' + t).style.display = t === tab ? '' : 'none';
    document.getElementById('rt_tab_' + t).className = t === tab ? active : idle;
  });
}

function copyText(id) {
  var el = document.getElementById(id);
  if (el) navigator.clipboard.writeText(el.textContent.trim());
}

// Advance as soon as GitLaunch receives the first build report.
(function () {
  var es = new EventSource('/build-created-stream/{{serviceId}}');
  es.addEventListener('build:created', function () {
    es.close();
    window.location.href = '/onboarding/setup-deploy/{{serviceId}}';
  });
})();
</script>
