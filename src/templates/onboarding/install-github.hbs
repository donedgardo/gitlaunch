          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">
            Install the GitHub App
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-sm mx-auto">
            Install the GitDeploy GitHub App to connect your repositories and enable one-click deployments.
          </p>

          <!-- Features List -->
          <div class="text-left bg-gray-50 dark:bg-gray-700/50 rounded-xl p-6 mb-8">
            <ul class="space-y-3">
              <li class="flex items-center text-gray-600 dark:text-gray-300">
                <svg style="width: 20px; height: 20px; min-width: 20px;" class="text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Trigger GitHub Actions workflows
              </li>
              <li class="flex items-center text-gray-600 dark:text-gray-300">
                <svg style="width: 20px; height: 20px; min-width: 20px;" class="text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Read repository metadata
              </li>
              <li class="flex items-center text-gray-600 dark:text-gray-300">
                <svg style="width: 20px; height: 20px; min-width: 20px;" class="text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Receive webhook notifications
              </li>
            </ul>
          </div>

          <a
