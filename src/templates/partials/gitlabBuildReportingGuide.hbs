{{!-- GitLab CI build reporting. Vars: apiUrl, serviceId, idPrefix (optional).

     The job comes from services/setup/setupSnippets.ts via the setupSnippet
     helper — the same generator /setup-snippets serves. Never paste a copy of
     it here; that is how the GitHub guides drifted apart. --}}
<div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
  <div class="p-6 sm:p-8">
    <div style="flex: 1; min-width: 0;">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
        Report Builds from GitLab CI
      </h2>
      <p class="text-gray-600 dark:text-gray-400 mb-4">
        Add this job to your <code class="text-xs bg-gray-100 dark:bg-gray-700 px-1.5 py-0.5 rounded">.gitlab-ci.yml</code>. It runs after your build stages and reports each build on your default branch to GitLaunch:
      </p>
      <div class="relative">
        <div class="bg-gray-900 dark:bg-gray-950 rounded-xl p-4 font-mono text-xs text-green-400 overflow-x-auto">
          <pre class="whitespace-pre"><code id="{{idPrefix}}gitlab_build">{{setupSnippet "buildReport.gitlab" apiUrl=apiUrl serviceId=serviceId}}</code></pre>
        </div>
        <button
          onclick="copyReportSnippet('{{idPrefix}}gitlab_build', '{{idPrefix}}gitlab_build_copy', '{{idPrefix}}gitlab_build_check')"
          class="absolute top-3 right-3 p-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors"
          title="Copy to clipboard"
        >
          <svg id="{{idPrefix}}gitlab_build_copy" style="width: 20px; height: 20px;" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
          </svg>
          <svg id="{{idPrefix}}gitlab_build_check" style="width: 20px; height: 20px; display: none;" class="text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </button>
      </div>
      <div class="mt-3 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-3">
        <p class="text-xs text-blue-700 dark:text-blue-300">
          Add <code class="bg-blue-100 dark:bg-blue-900/40 px-1 rounded">GITLAUNCH_API_KEY</code> as a
          <strong>masked</strong> CI/CD variable (Settings → CI/CD → Variables). Leave it unprotected
          if your default branch is not a protected branch, or the job will see an empty key.
          The payload is built with <code class="bg-blue-100 dark:bg-blue-900/40 px-1 rounded">jq</code>
          so a multi-line commit message is valid JSON, and the commit time comes from
          <code class="bg-blue-100 dark:bg-blue-900/40 px-1 rounded">$CI_COMMIT_TIMESTAMP</code>,
          so lead time measures commit-to-live.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
if (typeof copyReportSnippet !== 'function') {
  function copyReportSnippet(codeId, copyIconId, checkIconId) {
    var code = document.getElementById(codeId).textContent;
    var copyIcon = document.getElementById(copyIconId);
    var checkIcon = document.getElementById(checkIconId);
    navigator.clipboard.writeText(code).then(function () {
      copyIcon.style.display = 'none';
      checkIcon.style.display = 'block';
      setTimeout(function () {
        copyIcon.style.display = 'block';
        checkIcon.style.display = 'none';
      }, 2000);
    });
  }
}
</script>
