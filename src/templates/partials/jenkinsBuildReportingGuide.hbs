<!-- Jenkins Build Reporting Instructions Partial -->
<!-- Requires: apiUrl, serviceId -->
<div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
  <div class="p-6 sm:p-8">
    <div style="flex: 1; min-width: 0;">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
        Report Builds from Your Jenkins CI Pipeline
      </h2>
      <p class="text-gray-600 dark:text-gray-400 mb-4">
        Add this stage to your CI <code class="text-xs bg-gray-100 dark:bg-gray-700 px-1.5 py-0.5 rounded">Jenkinsfile</code> to report each build to GitLaunch:
      </p>
      <div class="relative">
        <div class="bg-gray-900 dark:bg-gray-950 rounded-xl p-4 font-mono text-xs text-green-400 overflow-x-auto">
          <pre class="whitespace-pre"><code>stage('Report build to GitLaunch') {
  when { branch 'main' }
  environment { GITLAUNCH_API_KEY = credentials('gitlaunch-api-key') }
  steps {
    sh '''
      COMMIT_AT="$(git show -s --format=%cI $GIT_COMMIT)"
      curl -fsS -X POST "{{apiUrl}}/api/v1/services/{{serviceId}}/builds" \
        -H "Authorization: Bearer $GITLAUNCH_API_KEY" \
        -H "Content-Type: application/json" \
        -d "{\"buildId\":\"$GIT_COMMIT\",\"commitAt\":\"$COMMIT_AT\"}"
    '''
  }
}</code></pre>
        </div>
        <button
          onclick="copyJenkinsBuildCode()"
          class="absolute top-3 right-3 p-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors"
          title="Copy to clipboard"
        >
          <svg id="jenkins_build_copy_icon" style="width: 20px; height: 20px;" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
          </svg>
          <svg id="jenkins_build_check_icon" style="width: 20px; height: 20px; display: none;" class="text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </button>
      </div>
      <div class="mt-3 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-3">
        <p class="text-xs text-blue-700 dark:text-blue-300">
          Add a Jenkins credential named <code class="bg-blue-100 dark:bg-blue-900/40 px-1 rounded">gitlaunch-api-key</code> (Secret text) holding a GitLaunch API key with the <strong>builds:write</strong> and <strong>deployments:write</strong> scopes.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
function copyJenkinsBuildCode() {
  var code = "stage('Report build to GitLaunch') {\n  when { branch 'main' }\n  environment { GITLAUNCH_API_KEY = credentials('gitlaunch-api-key') }\n  steps {\n    sh '''\n      COMMIT_AT=\"$(git show -s --format=%cI $GIT_COMMIT)\"\n      curl -fsS -X POST \"{{apiUrl}}/api/v1/services/{{serviceId}}/builds\" \\\n        -H \"Authorization: Bearer $GITLAUNCH_API_KEY\" \\\n        -H \"Content-Type: application/json\" \\\n        -d \"{\\\"buildId\\\":\\\"$GIT_COMMIT\\\",\\\"commitAt\\\":\\\"$COMMIT_AT\\\"}\"\n    '''\n  }\n}";
  var copyIcon = document.getElementById('jenkins_build_copy_icon');
  var checkIcon = document.getElementById('jenkins_build_check_icon');
  navigator.clipboard.writeText(code).then(function() {
    copyIcon.style.display = 'none';
    checkIcon.style.display = 'block';
    setTimeout(function() {
      copyIcon.style.display = 'block';
      checkIcon.style.display = 'none';
    }, 2000);
  });
}
</script>
