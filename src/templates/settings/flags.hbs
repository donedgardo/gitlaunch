{{> navigation }}

<!-- Main Content -->
<div class="min-h-screen bg-gray-50 dark:bg-gray-900" data-page="flags">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white">
            {{serviceName}} Feature Flags
          </h1>
          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            Gate features, roll out gradually, and run A/B experiments per environment.
          </p>
        </div>
        <a
          href="/services/{{serviceId}}/settings"
          class="text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300"
        >
          ← Service Settings
        </a>
      </div>
    </div>

    <!-- Create Flag -->
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm mb-8">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">New Flag</h2>
      </div>
      <form
        class="px-6 py-4 flex flex-col sm:flex-row gap-3 sm:items-end"
        hx-post="/services/{{serviceId}}/flags"
        hx-target="#flag-list"
        hx-swap="innerHTML"
        hx-on::after-request="if(event.detail.successful) this.reset()"
      >
        <div class="flex-1">
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Key</label>
          <input
            type="text"
            name="key"
            required
            placeholder="new-checkout"
            pattern="[a-z0-9]+(-[a-z0-9]+)*"
            title="lowercase alphanumeric with hyphens"
            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-900 text-gray-900 dark:text-white text-sm"
          />
        </div>
        <div class="flex-1">
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Description</label>
          <input
            type="text"
            name="description"
            placeholder="Optional"
            class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-900 text-gray-900 dark:text-white text-sm"
          />
        </div>
        <button
          type="submit"
          class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors whitespace-nowrap"
        >
          Add Flag
        </button>
      </form>
    </div>

    <!-- Flag List -->
    <div id="flag-list">
      {{> flagList flags=flags environments=environments serviceId=serviceId }}
    </div>

    <!-- Connect an app -->
    <div class="mt-8 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Connect an app</h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
          Evaluate these flags from your app. You need two things: the client and a key — a secret one if you
          call from your server, a publishable one if you call from the browser.
        </p>
      </div>
      <div class="px-6 py-4 space-y-5">
        <!-- The client comes first: pasting the raw endpoint leaves the reader
             to build caching, timeouts and a fallback themselves, and the
             fallback is the part that decides what users see during an outage. -->
        <div>
          <label class="block text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">Check a flag</label>
          <div class="relative">
            <pre class="bg-gray-900 rounded-lg p-3 pr-16 text-xs text-green-400 overflow-x-auto"><code id="flag-sdk">npm install @gitlaunch/flags

import &#123; createFlagClient &#125; from "@gitlaunch/flags";

const flags = createFlagClient(&#123;
  apiUrl: "{{apiUrl}}",
  serviceId: "{{serviceId}}",
  environment: "{{evaluateEnv}}",
  apiKey: process.env.GITLAUNCH_FLAG_KEY,
&#125;);

// USER_ID must be stable for a user, or they'll flip between variants.
if (await flags.isEnabled("my-flag", &#123; entity: USER_ID &#125;)) &#123;
  // ...ship it
&#125;

// Running an experiment? Record what you're optimising for:
await flags.track("my-flag", &#123; entity: USER_ID, goal: "signup" &#125;);</code></pre>
            <button type="button" onclick="copyFlagSnippet('flag-sdk', this)"
              class="absolute top-2 right-2 px-2 py-1 text-xs bg-gray-800 hover:bg-gray-700 text-gray-300 rounded">Copy</button>
          </div>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
            One round trip per user rather than per flag, a 1.5s timeout, and your fallback if we're unreachable.
            <a href="https://github.com/donedgardo/gitlaunch/blob/main/docs/feature-flags.md" class="underline hover:text-gray-700 dark:hover:text-gray-300">Full guide →</a>
          </p>
        </div>

        <!-- Endpoint -->
        <div>
          <label class="block text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">Or call the endpoint directly</label>
          <div class="relative">
            <pre class="bg-gray-900 rounded-lg p-3 pr-16 text-xs text-green-400 overflow-x-auto"><code id="flag-endpoint">{{apiUrl}}/api/v1/services/{{serviceId}}/environments/{{evaluateEnv}}/flags/evaluate?entity=USER_ID</code></pre>
            <button type="button" onclick="copyFlagSnippet('flag-endpoint', this)"
              class="absolute top-2 right-2 px-2 py-1 text-xs bg-gray-800 hover:bg-gray-700 text-gray-300 rounded">Copy</button>
          </div>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
            Swap <code>USER_ID</code> for a stable identifier so each visitor gets a consistent variant.
          </p>
        </div>

        {{#if bundleUrl}}
          <!-- Published bundle: a browser SDK can fetch this directly and
               evaluate locally instead of calling us per request. Once it
               ships in a frontend it's public the same way the compiled JS
               is — there's no way to "leak" something that's meant to be
               embedded in a public bundle. What's actually different from
               the publishable key is that this URL has no per-request check
               (no origin allow-list) — rotating gives you a fresh URL when
               you want to retire an old one (e.g. a decommissioned build),
               not a response to a secret getting out. -->
          <div>
            <label class="block text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">Published bundle (local evaluation)</label>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400 mb-2">
              Pass this URL as <code>bundleUrl</code> to evaluate flags locally in the browser instead of calling us on
              every request. Once it's in your frontend it's public the same way your compiled JS is — anyone can read
              this environment's flag config from it directly, with no per-request check like your publishable key's
              origin allow-list. Rotate it below to retire an old URL (e.g. a decommissioned build) without touching
              your API keys.
            </p>
            <div id="flag-bundle-url-panel">
              {{> flagBundleUrl bundleUrl=bundleUrl serviceId=serviceId}}
            </div>
          </div>
        {{/if}}

        <!-- Auth: two different keys, because a browser and a server are not
             the same threat model. Presenting one key for both is how secrets
             end up in JS bundles. -->
        <div>
          <label class="block text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-3">Authentication</label>

          <div class="grid gap-4 md:grid-cols-2">
            <!-- Server-side -->
            <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4 flex flex-col">
              <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Calling from your server</h3>
              <p class="mt-1 text-sm text-gray-600 dark:text-gray-400 flex-1">
                A <span class="font-medium">secret</span> key (<code class="text-xs">sk_…</code>). It can read this account's
                flag configuration and results, so keep it server-side — never in a browser, mobile app, or repo.
              </p>
              <button type="button"
                hx-post="/services/{{serviceId}}/flags/keys"
                hx-target="#flag-key-result"
                hx-swap="innerHTML"
                class="mt-3 px-4 py-2 bg-gray-900 dark:bg-gray-700 text-white text-sm font-medium rounded-lg hover:bg-gray-800 dark:hover:bg-gray-600 transition-colors">
                Create secret key
              </button>
            </div>

            <!-- Browser -->
            <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4 flex flex-col">
              <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Calling from the browser</h3>
              <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
                A <span class="font-medium">publishable</span> key (<code class="text-xs">pk_…</code>). Safe to ship in your
                frontend: it can only evaluate this service's flags, in one environment, from the origins you list.
              </p>
              <form class="mt-3 space-y-2 flex-1 flex flex-col"
                hx-post="/services/{{serviceId}}/flags/keys/browser"
                hx-target="#flag-key-result"
                hx-swap="innerHTML">
                <div>
                  <label for="browser-key-env" class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Environment</label>
                  <select id="browser-key-env" name="environment"
                    class="w-full px-2 py-1.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-900 text-gray-900 dark:text-white text-sm">
                    {{#each environments}}
                      <option value="{{this}}">{{this}}</option>
                    {{/each}}
                  </select>
                </div>
                <div class="flex-1">
                  <label for="browser-key-origins" class="block text-xs text-gray-500 dark:text-gray-400 mb-1">Allowed origins</label>
                  <input type="text" id="browser-key-origins" name="origins" required
                    placeholder="https://app.example.com, https://staging.example.com"
                    class="w-full px-2 py-1.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-900 text-gray-900 dark:text-white text-sm" />
                </div>
                <button type="submit"
                  class="px-4 py-2 bg-gray-900 dark:bg-gray-700 text-white text-sm font-medium rounded-lg hover:bg-gray-800 dark:hover:bg-gray-600 transition-colors">
                  Create publishable key
                </button>
              </form>
            </div>
          </div>

          <div id="flag-key-result" class="mt-3"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Blank variant row cloned by the "Add variant" button. Kept in the page
     shell (not the swapped partial) so it survives HTMX list re-renders. -->
<template id="variant-row-template">
  <div class="variant-row flex items-center gap-2">
    <input
      type="text"
      name="variantKey"
      placeholder="variant-key"
      pattern="[a-z0-9]+(-[a-z0-9]+)*"
      title="lowercase alphanumeric with hyphens"
      class="flex-1 px-2 py-1 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-900 text-gray-900 dark:text-white text-sm font-mono"
    />
    <input
      type="number"
      name="variantWeight"
      min="0"
      max="100"
      class="w-20 px-2 py-1 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-900 text-gray-900 dark:text-white text-sm"
    />
    <span class="text-gray-400 text-sm">%</span>
    <button
      type="button"
      data-remove-variant
      aria-label="Remove variant"
      class="px-2 py-1 text-gray-400 hover:text-red-600 dark:hover:text-red-400 rounded-lg transition-colors"
    >✕</button>
  </div>
</template>

<script>
  // Shared clipboard helper for the "Connect an app" panel and the minted-key
  // result (which is swapped in by HTMX and reuses this function).
  function copyFlagSnippet(id, btn) {
    var el = document.getElementById(id);
    if (!el) return;
    navigator.clipboard.writeText(el.textContent.trim()).then(function () {
      var prev = btn.textContent;
      btn.textContent = "Copied";
      setTimeout(function () {
        btn.textContent = prev;
      }, 1500);
    });
  }

  (function () {
    // Recompute and display the running weight total for one variant form,
    // flagging it red until the weights sum to exactly 100 (what the server
    // requires). An empty form shows nothing.
    function updateTotal(form) {
      var label = form.querySelector("[data-variant-total]");
      if (!label) return;
      var weights = form.querySelectorAll('input[name="variantWeight"]');
      if (weights.length === 0) {
        label.textContent = "";
        return;
      }
      var total = 0;
      weights.forEach(function (input) {
        total += parseInt(input.value, 10) || 0;
      });
      label.textContent = "Total: " + total + "%";
      label.classList.toggle("text-red-500", total !== 100);
    }

    function refreshAllTotals() {
      document.querySelectorAll(".variant-form").forEach(updateTotal);
    }

    // Lowest index not already used by a rule in this form. querySelectorAll
    // does not descend into <template> content, so the blank rows kept inside
    // the form never count here.
    function nextRuleIndex(form) {
      var max = -1;
      form.querySelectorAll('input[name="ruleIndex"]').forEach(function (input) {
        var value = parseInt(input.value, 10);
        if (!isNaN(value) && value > max) max = value;
      });
      return String(max + 1);
    }

    // Stamp a freshly cloned rule or condition with the rule it belongs to.
    function setRuleIndex(fragment, index) {
      fragment
        .querySelectorAll('input[name="ruleIndex"], input[name="condRule"]')
        .forEach(function (input) {
          input.value = index;
        });
    }

    // Delegate on document so handlers keep working after HTMX swaps the list.
    document.addEventListener("click", function (e) {
      var addBtn = e.target.closest("[data-add-variant]");
      if (addBtn) {
        var form = addBtn.closest("form");
        var rows = form.querySelector(".variant-rows");
        var tpl = document.getElementById("variant-row-template");
        rows.appendChild(tpl.content.cloneNode(true));
        updateTotal(form);
        return;
      }
      var removeBtn = e.target.closest("[data-remove-variant]");
      if (removeBtn) {
        var row = removeBtn.closest(".variant-row");
        var parentForm = removeBtn.closest("form");
        if (row) row.remove();
        if (parentForm) updateTotal(parentForm);
        return;
      }

      var addRuleBtn = e.target.closest("[data-add-rule]");
      if (addRuleBtn) {
        var ruleForm = addRuleBtn.closest("form");
        var ruleTpl = ruleForm.querySelector("[data-rule-template]");
        var rule = ruleTpl.content.cloneNode(true);
        // A rule and its conditions are tied together by this index, which only
        // has to be unique within the form — removing rules may leave gaps.
        setRuleIndex(rule, nextRuleIndex(ruleForm));
        ruleForm.querySelector(".targeting-rules").appendChild(rule);
        return;
      }

      var addCondBtn = e.target.closest("[data-add-condition]");
      if (addCondBtn) {
        var ownerRule = addCondBtn.closest(".targeting-rule");
        var condForm = addCondBtn.closest("form");
        var condTpl = condForm.querySelector("[data-condition-template]");
        var condition = condTpl.content.cloneNode(true);
        setRuleIndex(
          condition,
          ownerRule.querySelector('input[name="ruleIndex"]').value,
        );
        ownerRule.querySelector(".targeting-conditions").appendChild(condition);
        return;
      }

      var removeCondBtn = e.target.closest("[data-remove-condition]");
      if (removeCondBtn) {
        var condRow = removeCondBtn.closest(".condition-row");
        if (condRow) condRow.remove();
        return;
      }

      var removeRuleBtn = e.target.closest("[data-remove-rule]");
      if (removeRuleBtn) {
        var doomedRule = removeRuleBtn.closest(".targeting-rule");
        if (doomedRule) doomedRule.remove();
      }
    });

    document.addEventListener("input", function (e) {
      if (
        e.target.name === "variantKey" ||
        e.target.name === "variantWeight"
      ) {
        var form = e.target.closest("form");
        if (form) updateTotal(form);
      }
    });

    document.addEventListener("DOMContentLoaded", refreshAllTotals);
    document.body.addEventListener("htmx:afterSwap", refreshAllTotals);
  })();
</script>
