<!-- Onboarding: Install GitHub App -->
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 flex flex-col items-center justify-center px-4">
  <div class="max-w-md w-full">
    <!-- Logo/Brand -->
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Welcome to GitDeploy</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">Let's get you set up in just a few steps</p>
    </div>

    <!-- Progress indicator -->
    <div class="flex items-center justify-center mb-8">
      <div class="flex items-center">
        <div class="w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center text-white font-semibold">1</div>
        <div class="w-16 h-1 bg-gray-300 dark:bg-gray-700 mx-2"></div>
        <div class="w-8 h-8 bg-gray-300 dark:bg-gray-700 rounded-full flex items-center justify-center text-gray-600 dark:text-gray-400 font-semibold">2</div>
        <div class="w-16 h-1 bg-gray-300 dark:bg-gray-700 mx-2"></div>
        <div class="w-8 h-8 bg-gray-300 dark:bg-gray-700 rounded-full flex items-center justify-center text-gray-600 dark:text-gray-400 font-semibold">3</div>
      </div>
    </div>

    <!-- Card -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
      <div class="text-center">
        <!-- GitHub icon -->
        <div class="w-16 h-16 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-gray-900 dark:text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </div>

        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Connect Your Repositories</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-6">
          Install the GitDeploy GitHub App to connect your repositories and enable one-click deployments.
        </p>

        <a
          href="{{installUrl}}"
          hx-boost="false"
          class="inline-block w-full px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors"
        >
          Install GitHub App
        </a>

        <p class="mt-4 text-sm text-gray-500 dark:text-gray-500">
          You'll be redirected to GitHub to authorize access
        </p>
      </div>
    </div>

    <!-- Help text -->
    <p class="mt-6 text-center text-sm text-gray-500 dark:text-gray-500">
      Need help? Check out our <a href="#" class="text-blue-600 hover:underline">documentation</a>
    </p>
  </div>
</div>
