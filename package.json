{
  "name": "gitlaunch",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently --kill-others \"yarn run server:watch\" \"yarn run tailwind:watch\"",
    "server:watch": "nodemon -e ts,hbs --exec tsx src/index.ts",
    "tailwind": "yarn tailwindcss -i ./src/styles/input.css -o src/public/css/main.css",
    "tailwind:watch": "yarn run tailwind --watch",
    "start": "node dist/index.js",
    "test": "yarn test:watch --run",
    "test:e2e": "vitest --run --dir src/tests && playwright test",
    "test:watch": "vitest",
    "prepare": "husky",
    "postbuild": "ncp src/templates dist/templates && ncp src/public dist/public"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/oauth2": "^7.8.0",
    "@fastify/static": "^7.0.1",
    "@fastify/view": "^9.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "fastify-sse-v2": "^4.0.0",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.2",
    "cheerio": "^1.0.0-rc.12",
    "concurrently": "^8.2.2",
    "fastify-tsconfig": "^2.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "mongodb-memory-server": "^11.0.1",
    "ncp": "^2.0.0",
    "nodemon": "^3.1.0",
    "prettier": "3.2.5",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "vitest": "^1.3.1"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "resolutions": {
    "wrap-ansi": "7.0.0",
    "strip-ansi": "6.0.0",
    "string-width": "4.2.3"
  }
}
