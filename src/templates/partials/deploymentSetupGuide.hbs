<!-- Deployment Workflow Instructions -->
<div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
  <div class="p-6 sm:p-8">
    <div style="display: flex; align-items: flex-start;">
      {{#if stepNumber}}
      <div style="width: 32px; height: 32px; min-width: 32px; display: flex; align-items: center; justify-content: center;" class="bg-blue-600 text-white rounded-full font-semibold mr-4">
        {{stepNumber}}
      </div>
      {{/if}}
      <div style="flex: 1; min-width: 0;">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
          Set Up Your Deploy Workflow
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          Save this as <code class="text-xs bg-gray-100 dark:bg-gray-700 px-1.5 py-0.5 rounded">.github/workflows/deploy.yml</code>:
        </p>
        <div class="relative">
          <div class="bg-gray-900 dark:bg-gray-950 rounded-xl p-4 font-mono text-xs text-green-400 overflow-x-auto">
            <pre class="whitespace-pre"><code>name: Deploy

on:
  workflow_dispatch:
    inputs:
      environment:
        description: "Environment to deploy to"
        required: true
        type: choice
        options:
{{#each environments}}
          - {{this.name}}
{{else}}
          - staging
          - prod
{{/each}}
      buildId:
        description: "Build ID (commit SHA)"
        required: false
        type: string
  workflow_call:
    inputs:
      environment:
        required: true
        type: string
      buildId:
        required: false
        type: string

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: $&#123;&#123; inputs.buildId || github.sha &#125;&#125;

      - uses: donedgardo/build-reporter@v2
        with:
          api-key: $&#123;&#123; secrets.GITLAUNCH_API_KEY &#125;&#125;
          service-id: $&#123;&#123; vars.GITLAUNCH_SERVICE_ID &#125;&#125;
          environment: $&#123;&#123; inputs.environment &#125;&#125;
          build-id: $&#123;&#123; inputs.buildId || github.sha &#125;&#125;
          action: deploy

      ####################################
      # Add your deployment steps here   #
      ####################################
      - name: Deploy
        run: echo "Deploy to $&#123;&#123; inputs.environment &#125;&#125;"</code></pre>
          </div>
          <button
            onclick="copyDeployCode('sample')"
            class="absolute top-3 right-3 p-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors"
            title="Copy to clipboard"
          >
            <svg id="deploy_sample_copy_icon" style="width: 20px; height: 20px;" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
            <svg id="deploy_sample_check_icon" style="width: 20px; height: 20px; display: none;" class="text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </button>
        </div>
        <div class="mt-3 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-3">
          <p class="text-xs text-blue-700 dark:text-blue-300">
            Replace the deploy step with your actual deploy command.
          </p>
        </div>

        <!-- Terminal command option -->
        <div class="mt-4">
          <div style="display: flex; align-items: center;" class="mb-3">
            <div class="flex-1 border-t border-gray-200 dark:border-gray-700"></div>
            <span class="px-3 text-xs text-gray-400 dark:text-gray-500">or copy this command in your terminal to create a PR</span>
            <div class="flex-1 border-t border-gray-200 dark:border-gray-700"></div>
          </div>
          <div class="relative">
            <div class="bg-gray-900 dark:bg-gray-950 rounded-xl p-4 font-mono text-xs text-green-400 overflow-x-auto">
              <pre class="whitespace-pre"><code>mkdir -p .github/workflows &amp;&amp; cat &gt; .github/workflows/deploy.yml &lt;&lt; 'EOF'
name: Deploy

on:
  workflow_dispatch:
    inputs:
      environment:
        description: "Environment to deploy to"
        required: true
        type: choice
        options:
          - staging
          - prod
      buildId:
        description: "Build ID (commit SHA)"
        required: false
        type: string
  workflow_call:
    inputs:
      environment:
        required: true
        type: string
      buildId:
        required: false
        type: string

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: $&#123;&#123; inputs.buildId || github.sha &#125;&#125;

      - uses: donedgardo/build-reporter@v2
        with:
          api-key: $&#123;&#123; secrets.GITLAUNCH_API_KEY &#125;&#125;
          service-id: $&#123;&#123; vars.GITLAUNCH_SERVICE_ID &#125;&#125;
          environment: $&#123;&#123; inputs.environment &#125;&#125;
          build-id: $&#123;&#123; inputs.buildId || github.sha &#125;&#125;
          action: deploy

      ####################################
      # Add your deployment steps here   #
      ####################################
      - name: Deploy
        run: echo "Deploy to $&#123;&#123; inputs.environment &#125;&#125;"
EOF
git checkout -b add-deploy-workflow &amp;&amp; \
git add .github/workflows/deploy.yml &amp;&amp; \
git commit -m "ci: add deploy workflow with GitLaunch" &amp;&amp; \
git push -u origin add-deploy-workflow &amp;&amp; \
gh pr create --title "Add deploy workflow" --body "Adds deploy pipeline with GitLaunch deploy reporting"</code></pre>
            </div>
            <button
              onclick="copyDeployCode('terminal')"
              class="absolute top-3 right-3 p-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors"
              title="Copy to clipboard"
            >
              <svg id="deploy_terminal_copy_icon" style="width: 20px; height: 20px;" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              <svg id="deploy_terminal_check_icon" style="width: 20px; height: 20px; display: none;" class="text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Tip: Auto-deploy from CI -->
        <div class="mt-6 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-4">
          <div style="display: flex; align-items: flex-start;">
            <svg style="width: 20px; height: 20px; min-width: 20px;" class="text-blue-600 dark:text-blue-400 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <h3 class="font-semibold text-blue-800 dark:text-blue-200 mb-1">Auto-deploy from CI</h3>
              <p class="text-sm text-blue-700 dark:text-blue-300 mb-3">
                Want to auto-deploy after your tests pass? Add this job to your CI workflow:
              </p>
              <div class="bg-gray-900 dark:bg-gray-950 rounded-lg p-3 font-mono text-xs text-green-400 overflow-x-auto">
                <pre class="whitespace-pre"><code>  deploy:
    needs: [build]
    if: github.ref == 'refs/heads/main'
    uses: ./.github/workflows/deploy.yml
    with:
      environment: {{#if environments.[0]}}{{environments.[0].name}}{{else}}staging{{/if}}
      buildId: $&#123;&#123; github.sha &#125;&#125;</code></pre>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
function copyDeployCode(tab) {
  var dl = '$' + '{{';
  var dr = '}}';
  var deployYaml = 'name: Deploy\n\non:\n  workflow_dispatch:\n    inputs:\n      environment:\n        description: "Environment to deploy to"\n        required: true\n        type: choice\n        options:\n          - staging\n          - prod\n      buildId:\n        description: "Build ID (commit SHA)"\n        required: false\n        type: string\n  workflow_call:\n    inputs:\n      environment:\n        required: true\n        type: string\n      buildId:\n        required: false\n        type: string\n\njobs:\n  deploy:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          ref: ' + dl + ' inputs.buildId || github.sha ' + dr + '\n\n      - uses: donedgardo/build-reporter@v2\n        with:\n          api-key: ' + dl + ' secrets.GITLAUNCH_API_KEY ' + dr + '\n          service-id: ' + dl + ' vars.GITLAUNCH_SERVICE_ID ' + dr + '\n          environment: ' + dl + ' inputs.environment ' + dr + '\n          build-id: ' + dl + ' inputs.buildId || github.sha ' + dr + '\n          action: deploy\n\n      ####################################\n      # Add your deployment steps here   #\n      ####################################\n      - name: Deploy\n        run: echo "Deploy to ' + dl + ' inputs.environment ' + dr + '"';

  var code;
  if (tab === 'terminal') {
    code = 'mkdir -p .github/workflows && cat > .github/workflows/deploy.yml << \'EOF\'\n' + deployYaml + '\nEOF\ngit checkout -b add-deploy-workflow && \\\ngit add .github/workflows/deploy.yml && \\\ngit commit -m "ci: add deploy workflow with GitLaunch" && \\\ngit push -u origin add-deploy-workflow && \\\ngh pr create --title "Add deploy workflow" --body "Adds deploy pipeline with GitLaunch deploy reporting"';
  } else {
    code = deployYaml;
  }
  var copyIcon = document.getElementById('deploy_' + tab + '_copy_icon');
  var checkIcon = document.getElementById('deploy_' + tab + '_check_icon');
  navigator.clipboard.writeText(code).then(function() {
    copyIcon.style.display = 'none';
    checkIcon.style.display = 'block';
    setTimeout(function() {
      copyIcon.style.display = 'block';
      checkIcon.style.display = 'none';
    }, 2000);
  });
}
</script>
