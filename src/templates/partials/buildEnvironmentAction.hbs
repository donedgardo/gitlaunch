<td
  id="{{serviceName}}-{{buildId}}-{{env}}"
  sse-swap="update:{{serviceName}}-{{buildId}}-{{env}}"
  {{#if isOobSwap}}hx-swap-oob="outerHTML"{{/if}}
  class="gl-env-cell"
>
  {{#if canDispatch}}
    {{#if (showDeployButton status) }}
      <button
        hx-patch="/services/{{serviceId}}/builds/{{buildId}}/deploy/{{env}}"
        hx-target="#{{serviceName}}-{{buildId}}-{{env}}"
        hx-disabled-elt="this"
        hx-on::before-request="this.innerHTML='<span class=\'gl-dot\'></span>dispatching'; this.className='pill pill-pending';"
        class="cbtn"
      >
        Deploy
      </button>
    {{else}}
      <div class="inline-flex items-center gap-2">
        <span class="{{getStatusBadgeClass status}}">{{#if (showStatusDot status)}}<span class="gl-dot"></span>{{/if}}{{status}}</span>
        {{#if (showDeployedAt status deployedAt)}}<span class="gl-when-env">{{timeAgo deployedAt}}</span>{{/if}}
        {{#if (canCancel status)}}
          <button
            hx-delete="/services/{{serviceId}}/builds/{{buildId}}/deploy/{{env}}"
            hx-target="#{{serviceName}}-{{buildId}}-{{env}}"
            hx-disabled-elt="this"
            hx-on::before-request="this.closest('div').querySelector('span').textContent='cancelling';"
            class="gl-icon-btn"
            title="Cancel deployment"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        {{/if}}
        {{#if (canRedeploy status)}}
          <button
            hx-patch="/services/{{serviceId}}/builds/{{buildId}}/deploy/{{env}}"
            hx-target="#{{serviceName}}-{{buildId}}-{{env}}"
            hx-disabled-elt="this"
            hx-on::before-request="this.closest('div').innerHTML='<span class=\'pill pill-pending\'><span class=\'gl-dot\'></span>dispatching</span>';"
            class="gl-icon-btn"
            title="Redeploy"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
          </button>
        {{/if}}
      </div>
    {{/if}}
  {{else}}
    {{#if status}}
      <span class="inline-flex items-center gap-2">
        <span class="{{getStatusBadgeClass status}}">{{#if (showStatusDot status)}}<span class="gl-dot"></span>{{/if}}{{status}}</span>
        {{#if (showDeployedAt status deployedAt)}}<span class="gl-when-env">{{timeAgo deployedAt}}</span>{{/if}}
      </span>
    {{else}}
      <span class="gl-empty-env">—</span>
    {{/if}}
  {{/if}}
</td>
