<style>
  /* Design tokens (--bg, --surface, --accent, …) are defined globally in
     src/styles/input.css and shared across the app. This page only adds its
     own component styles below. */

  * { box-sizing: border-box; }
  body { margin: 0; }
  .page { background: var(--bg); color: var(--ink); font-family: var(--sans); line-height: 1.55; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
  .wrap { max-width: 1160px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 40px); }
  a { color: inherit; }

  /* Entrance */
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .rise { opacity: 0; animation: rise .7s cubic-bezier(.2,.7,.2,1) forwards; }
  .d1 { animation-delay: .05s; } .d2 { animation-delay: .15s; } .d3 { animation-delay: .25s; }
  .d4 { animation-delay: .35s; } .d5 { animation-delay: .5s; }

  /* Nav */
  nav { position: sticky; top: 0; z-index: 20; backdrop-filter: saturate(1.4) blur(10px); background: color-mix(in srgb, var(--bg) 82%, transparent); border-bottom: 1px solid var(--line); }
  .nav-in { display: flex; align-items: center; justify-content: space-between; height: 62px; }
  .brand { font-weight: 800; font-size: 19px; letter-spacing: -.02em; display: flex; align-items: center; gap: 9px; }
  .brand .glyph { width: 22px; height: 22px; border-radius: 6px; background: linear-gradient(145deg, var(--accent), var(--accent-2)); display: inline-grid; place-items: center; color: #fff; font-size: 12px; box-shadow: 0 2px 8px rgba(255,90,31,.4); }
  .brand .glyph::before { content: "◮"; transform: rotate(0deg); }
  .brand .mk { color: var(--accent); }
  .nav-links { display: flex; align-items: center; gap: 26px; font-size: 14px; color: var(--muted); }
  .nav-links a { text-decoration: none; }
  .nav-links a:hover { color: var(--ink); }
  .btn { font-family: var(--sans); font-size: 14px; font-weight: 600; border-radius: 9px; padding: 10px 16px; border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: transform .12s ease, box-shadow .12s ease, background .12s ease; }
  .btn:hover { transform: translateY(-1px); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; box-shadow: 0 6px 18px rgba(255,90,31,.34); }
  .btn.primary:hover { box-shadow: 0 10px 26px rgba(255,90,31,.44); }
  .btn.ghost { background: transparent; }
  .nav-links .btn { padding: 8px 15px; }

  /* Hero */
  .hero { position: relative; padding: clamp(48px, 8vw, 96px) 0 clamp(40px, 6vw, 72px); background-image: var(--glow); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 56px); align-items: center; }
  .eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--accent-ink); display: inline-flex; align-items: center; gap: 9px; background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent); padding: 6px 12px; border-radius: 999px; }
  h1 { font-size: clamp(38px, 5.6vw, 66px); line-height: 1.02; letter-spacing: -.032em; font-weight: 820; margin: 22px 0 0; text-wrap: balance; }
  h1 .u { color: var(--accent); position: relative; }
  .subhead { font-size: clamp(16px, 1.9vw, 20px); color: var(--muted); max-width: 40ch; margin: 20px 0 0; text-wrap: balance; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin: 30px 0 0; }
  .cta-row .btn { padding: 13px 22px; font-size: 15px; }
  .trust { margin: 22px 0 0; font-family: var(--mono); font-size: 12.5px; color: var(--faint); display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .trust .ci { color: var(--muted); border: 1px solid var(--line); border-radius: 6px; padding: 3px 8px; background: var(--surface); }

  /* Board (signature) */
  .board-frame { position: relative; min-width: 0; }
  .board { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow-lg); overflow: hidden; max-width: 100%; }
  .board-bar { display: flex; align-items: center; gap: 10px; padding: 13px 16px; background: var(--surface-2); border-bottom: 1px solid var(--line); font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .dot3 { display: flex; gap: 6px; }
  .dot3 span { width: 10px; height: 10px; border-radius: 50%; background: var(--line-strong); }
  .board-bar .path { color: var(--faint); }
  .board-bar .rel { margin-left: auto; color: var(--accent-ink); }
  /* Release table — environments as COLUMNS, builds as ROWS (matches the app) */
  .rgrid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; }
  .rcell { padding: 13px 14px; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 4px; min-height: 60px; min-width: 0; }
  .rcell .build, .rcell .build-sub { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .rgrid .rcell:nth-child(3n+2), .rgrid .rcell:nth-child(3n) { border-left: 1px solid var(--line); }
  .rgrid .rcell:nth-last-child(-n+3) { border-bottom: none; }
  .rcell.rhead { min-height: 0; padding: 11px 16px; background: var(--surface-2); font-family: var(--mono); font-size: 10.5px; letter-spacing: .09em; text-transform: uppercase; color: var(--muted); }
  .build { font-family: var(--mono); font-size: 14px; font-weight: 600; letter-spacing: -.01em; }
  .build .sha { color: var(--accent-ink); }
  .build-sub { font-family: var(--mono); font-size: 10.5px; color: var(--faint); transition: color .3s ease; }
  .pill { font-family: var(--mono); font-size: 10px; letter-spacing: .05em; text-transform: uppercase; padding: 4px 9px; border-radius: 999px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .pill.live { color: var(--ok); background: color-mix(in srgb, var(--ok) 16%, transparent); }
  .live-dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .3; } }
  .cbtn { font-family: var(--mono); font-size: 11px; padding: 6px 12px; border-radius: 8px; border: 1px solid var(--accent); background: transparent; color: var(--accent-ink); font-weight: 600; white-space: nowrap; cursor: pointer; transition: background .12s ease, color .12s ease, transform .08s ease; }
  .cbtn:hover { background: var(--accent); color: #fff; }
  .cbtn:active { transform: translateY(1px); }
  .cbtn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cbtn:disabled { cursor: default; }
  .cbtn:disabled:hover { background: transparent; color: var(--accent-ink); }
  /* one-click deploy progress (inside a cell) */
  .cprog { height: 0; width: 100%; max-width: 100px; margin-top: 6px; border-radius: 4px; background: var(--surface-2); overflow: hidden; transition: height .25s ease; }
  .cprog.on { height: 4px; }
  .cprog-fill { height: 100%; width: 0; background: linear-gradient(90deg, var(--accent), var(--accent-2)); border-radius: 4px; transition: width 1.7s cubic-bezier(.4,.1,.2,1); }
  .cprog-fill.go { width: 100%; }
  @keyframes flash { 0% { background: var(--accent-soft); } 100% { background: transparent; } }
  .rcell.flash { animation: flash 1.4s ease-out; }
  .board-hint { text-align: center; margin-top: 12px; font-family: var(--mono); font-size: 11.5px; color: var(--faint); letter-spacing: .02em; }
  .board-hint b { color: var(--accent-ink); font-weight: 600; }
  .float-tag { position: absolute; right: -14px; top: -16px; background: var(--ink); color: var(--bg); font-family: var(--mono); font-size: 11px; padding: 7px 12px; border-radius: 999px; box-shadow: var(--shadow); transform: rotate(2deg); }
  .float-tag b { color: var(--accent-2); }

  /* Section scaffolding */
  section { position: relative; }
  .band { padding: clamp(52px, 8vw, 96px) 0; }
  .kicker { font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--accent-ink); }
  .h2 { font-size: clamp(28px, 4vw, 44px); line-height: 1.08; letter-spacing: -.028em; font-weight: 800; margin: 12px 0 0; text-wrap: balance; max-width: 20ch; }
  .lead2 { font-size: clamp(16px, 1.8vw, 19px); color: var(--muted); max-width: 54ch; margin: 16px 0 0; }

  /* Reframe strip */
  .reframe { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--surface); }
  .reframe-in { display: flex; align-items: center; justify-content: space-between; gap: 30px; padding: 26px 0; flex-wrap: wrap; }
  .reframe .line { font-size: clamp(18px, 2.4vw, 26px); font-weight: 700; letter-spacing: -.02em; }
  .reframe .line .dim { color: var(--faint); }
  .reframe .line .mk { color: var(--accent); }
  .reframe .stack { display: flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 12px; color: var(--muted); flex-wrap: wrap; }
  .reframe .chip { border: 1px solid var(--line-strong); border-radius: 7px; padding: 6px 11px; background: var(--surface-2); }

  /* Value trio */
  .trio { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 40px; }
  .vcard { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 26px 24px 28px; box-shadow: var(--shadow); position: relative; overflow: hidden; }
  .vcard::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 3px; background: linear-gradient(90deg, var(--accent), var(--accent-2)); opacity: .9; }
  .vcard .vi { width: 40px; height: 40px; border-radius: 10px; background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent); display: grid; place-items: center; margin-bottom: 16px; }
  .vcard .vi svg { width: 20px; height: 20px; stroke: var(--accent-ink); fill: none; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .vcard h3 { font-size: 20px; letter-spacing: -.02em; margin: 0 0 8px; font-weight: 740; }
  .vcard p { font-size: 14.5px; color: var(--muted); margin: 0; }
  .vcard .was { margin-top: 16px; font-family: var(--mono); font-size: 11px; color: var(--faint); border-top: 1px dashed var(--line); padding-top: 12px; }
  .vcard .was b { color: var(--accent-ink); font-weight: 600; }

  /* Fear panel */
  .fear-band { padding: clamp(52px, 8vw, 96px) 0; }
  .fear { background: #0D1418; color: #E7EEF3; border-radius: 20px; padding: clamp(30px, 5vw, 60px); border: 1px solid #23303A; position: relative; overflow: hidden; }
  :root[data-theme="light"] .fear { background: #101820; }
  .fear::after { content: ""; position: absolute; inset: 0; background: radial-gradient(50% 80% at 85% 0%, rgba(255,106,51,.16), transparent 60%); pointer-events: none; }
  .fear .kicker { color: var(--accent-2); position: relative; }
  .fear blockquote { position: relative; margin: 16px 0 0; font-size: clamp(24px, 4vw, 42px); line-height: 1.22; letter-spacing: -.025em; font-weight: 600; max-width: 20ch; text-wrap: balance; }
  .fear .after { position: relative; margin: 22px 0 0; font-size: clamp(16px, 2vw, 20px); color: #A9B6C0; max-width: 44ch; }
  .fear .after b { color: #fff; font-weight: 650; }
  .fear .three { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 34px; }
  .fear .fb { border-top: 2px solid var(--accent); padding-top: 12px; }
  .fear .fb .t { font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: #FF9060; }
  .fear .fb .d { font-size: 14px; color: #A9B6C0; margin-top: 6px; }

  /* Metrics */
  .metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 40px; }
  .metric { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 26px; box-shadow: var(--shadow); }
  .metric .big { font-size: clamp(34px, 5vw, 52px); font-weight: 820; letter-spacing: -.03em; line-height: 1; font-variant-numeric: tabular-nums; background: linear-gradient(120deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .metric .lbl { font-size: 14.5px; color: var(--muted); margin-top: 12px; }
  .metric .lbl b { color: var(--ink); font-weight: 650; }
  .metric .note { font-family: var(--mono); font-size: 11px; color: var(--faint); margin-top: 8px; }

  /* Final CTA */
  .final { text-align: center; padding: clamp(60px, 9vw, 110px) 0; background-image: var(--glow); }
  .final .h2 { margin-left: auto; margin-right: auto; max-width: 18ch; }
  .final .cta-row { justify-content: center; }
  .final .subhead2 { color: var(--muted); font-size: 17px; margin: 16px auto 0; max-width: 46ch; }

  /* Waitlist capture */
  .wl-form { display: flex; gap: 10px; margin: 26px auto 0; max-width: 460px; flex-wrap: wrap; justify-content: center; }
  .wl-form input[type="email"] { flex: 1 1 240px; min-width: 0; font-family: var(--sans); font-size: 15px; color: var(--ink); background: var(--surface); border: 1px solid var(--line-strong); border-radius: 9px; padding: 13px 15px; transition: border-color .12s ease, box-shadow .12s ease; }
  .wl-form input[type="email"]::placeholder { color: var(--faint); }
  .wl-form input[type="email"]:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .wl-form .btn { padding: 13px 22px; font-size: 15px; }
  /* Honeypot — kept in the layout but visually and semantically hidden from humans */
  .wl-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; opacity: 0; }
  .wl-note { font-family: var(--mono); font-size: 12px; color: var(--faint); margin: 14px auto 0; }
  .wl-result { margin: 18px auto 0; font-size: 15px; font-weight: 600; max-width: 460px; padding: 12px 16px; border-radius: 10px; }
  .wl-result.wl-ok { color: var(--ok); background: color-mix(in srgb, var(--ok) 14%, transparent); border: 1px solid color-mix(in srgb, var(--ok) 30%, transparent); }
  .wl-result.wl-error { color: var(--accent-ink); background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); }
  .wl-form.htmx-request .btn { opacity: .7; pointer-events: none; }

  footer { border-top: 1px solid var(--line); padding: 30px 0; }
  .foot-in { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; font-family: var(--mono); font-size: 12px; color: var(--faint); }
  .foot-legal { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .foot-legal a { color: var(--muted); text-decoration: none; }
  .foot-legal a:hover { color: var(--accent-ink); }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .board-frame { margin-top: 10px; }
    .nav-links a:not(.btn) { display: none; }
    .trio, .metrics, .fear .three { grid-template-columns: 1fr; }
    .reframe-in { flex-direction: column; align-items: flex-start; gap: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise { opacity: 1; animation: none; }
    .live-dot { animation: none; }
    .promo-fill { transition: none; }
    .env.flash { animation: none; }
  }
</style>

<div class="page">

  <nav>
    <div class="wrap nav-in">
      <div class="brand"><span class="glyph"></span>Git<span class="mk">Launch</span></div>
      <div class="nav-links">
        <a href="#how">How it works</a>
        <a href="#why">Why GitLaunch</a>
        <a href="/auth/github">Login</a>
        <a href="#start" class="btn primary">Join the waitlist</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <header class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow rise d1">Deployment control · not another CI/CD tool</span>
        <h1 class="rise d2">{{{heroHeadlineHtml}}}</h1>
        <p class="subhead rise d3">GitLaunch shows every build across every environment — and lets anyone on the team promote or roll back safely. No YAML. No hero. No deploy-day dread.</p>
        <div class="cta-row rise d4">
          <a href="#start" class="btn primary">{{heroCta}}</a>
          <a href="#how" class="btn ghost">See it live</a>
        </div>
        <div class="trust rise d4">
          Works on top of your CI —
          <span class="ci">GitHub Actions</span>
          <span class="ci">Jenkins</span>
          <span>or both.</span>
        </div>
      </div>

      <div class="board-frame rise d5">
        <div class="float-tag">deploy in <b>one click</b></div>
        <div class="board" id="board" role="group" aria-label="Interactive release board: click a Deploy button to move that build live in an environment">
          <div class="board-bar">
            <span class="dot3"><span></span><span></span><span></span></span>
            <span class="path">web-app · release board</span>
            <span class="rel">v2.15.0</span>
          </div>
          <div class="rgrid">
            <div class="rcell rhead">Commit</div>
            <div class="rcell rhead">Staging</div>
            <div class="rcell rhead">Production</div>

            <div class="rcell">
              <div class="build"><span class="sha">#c0d5aa</span> · Add shareable team invite links</div>
              <div class="build-sub">18m ago · ci</div>
            </div>
            <div class="rcell env-cell" data-col="staging" id="autoCell"><button class="cbtn" type="button">Deploy</button></div>
            <div class="rcell env-cell" data-col="prod"><button class="cbtn" type="button">Deploy</button></div>

            <div class="rcell">
              <div class="build"><span class="sha">#7e1b04</span> · Fix session cookie expiry</div>
              <div class="build-sub">2h ago · qa-maria</div>
            </div>
            <div class="rcell env-cell" data-col="staging"><span class="pill live"><span class="live-dot"></span>Live</span></div>
            <div class="rcell env-cell" data-col="prod"><button class="cbtn" type="button">Deploy</button></div>

            <div class="rcell">
              <div class="build"><span class="sha">#a3f9c2</span> · v2.15.0</div>
              <div class="build-sub">3d ago · ci</div>
            </div>
            <div class="rcell env-cell" data-col="staging"><button class="cbtn" type="button">Deploy</button></div>
            <div class="rcell env-cell" data-col="prod"><span class="pill live"><span class="live-dot"></span>Live&nbsp;3d</span></div>
          </div>
        </div>
        <div class="board-hint">Go on — click any <b>Deploy</b> button.</div>
      </div>
    </div>
  </header>

  <!-- REFRAME -->
  <section class="reframe">
    <div class="wrap reframe-in">
      <div class="line"><span class="dim">Your pipeline builds it.</span> GitLaunch <span class="mk">runs the show</span> after.</div>
      <div class="stack">
        <span>sits on top of</span>
        <span class="chip">GitHub Actions</span>
        <span class="chip">Jenkins</span>
        <span>— keep what you have</span>
      </div>
    </div>
  </section>

  <!-- VALUE TRIO -->
  <section class="band" id="how">
    <div class="wrap">
      <span class="kicker">What you get on day one</span>
      <h2 class="h2">Deployment, minus the ritual.</h2>
      <p class="lead2">Three fears about shipping software — turned into three things your whole team can just do.</p>
      <div class="trio">
        <div class="vcard">
          <div class="vi"><svg viewBox="0 0 24 24"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg></div>
          <h3>See everything</h3>
          <p>One screen answers "what's on staging?", "what's live?", and "what's ready to promote?" — no SHAs, no Slack, no spreadsheet.</p>
          <div class="was">Was: <b>nobody's sure what's actually in production.</b></div>
        </div>
        <div class="vcard">
          <div class="vi"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
          <h3>Anyone can ship</h3>
          <p>QA, PMs, product owners — anyone can promote a build between environments safely. Delivery stops depending on the one engineer who "knows."</p>
          <div class="was">Was: <b>only one person can deploy.</b></div>
        </div>
        <div class="vcard">
          <div class="vi"><svg viewBox="0 0 24 24"><path d="M3 2v6h6"/><path d="M3 8a9 9 0 1 0 2.5-5.9"/></svg></div>
          <h3>Instant rollback</h3>
          <p>A bad deploy stops being a war room. Roll back to the last good build in one click — seconds, not a scramble to remember how.</p>
          <div class="was">Was: <b>undo is slow and scary.</b></div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEAR -->
  <section class="fear-band" id="why">
    <div class="wrap">
      <div class="fear">
        <span class="kicker">Deploy day shouldn't feel like this</span>
        <blockquote>"We can't say what's live right now — and only one person can roll it back."</blockquote>
        <p class="after">That's the 3&nbsp;a.m. fear GitLaunch is built to end. <b>Make deploys visible, reversible, and something anyone can do</b> — and deploy day becomes boring, in the best way.</p>
        <div class="three">
          <div class="fb"><div class="t">Bus-factor → shared</div><div class="d">Deploys leave one person's head. The whole team can ship and undo.</div></div>
          <div class="fb"><div class="t">Blindness → visible</div><div class="d">Always know exactly what's running in every environment, right now.</div></div>
          <div class="fb"><div class="t">Slow undo → one click</div><div class="d">Roll back to the last good build the moment something looks wrong.</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- METRICS -->
  <section class="band">
    <div class="wrap">
      <span class="kicker">Why it matters</span>
      <h2 class="h2">The two DORA metrics your board asks about.</h2>
      <p class="lead2">GitLaunch moves the numbers that define elite delivery — because faster promotion and one-click rollback are exactly what they measure.</p>
      <div class="metrics">
        <div class="metric">
          <div class="big">↓ lead time</div>
          <div class="lbl"><b>Code-complete to live</b>, without waiting on the one person who can deploy.</div>
          <div class="note">DORA · delivery lead time</div>
        </div>
        <div class="metric">
          <div class="big">↓ MTTR</div>
          <div class="lbl"><b>One-click rollback</b> turns "how long were we down?" into seconds.</div>
          <div class="note">DORA · time to restore</div>
        </div>
        <div class="metric">
          <div class="big">0</div>
          <div class="lbl"><b>Pipelines to rebuild.</b> Sits on top of the CI you already run.</div>
          <div class="note">GitHub Actions · Jenkins · both</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA — waitlist -->
  <section class="final" id="start">
    <div class="wrap">
      <span class="kicker">{{ctaKicker}}</span>
      <h2 class="h2">{{ctaHeading}}</h2>
      <p class="subhead2">GitLaunch is almost ready. Join the waitlist and we'll send your invite when your spot opens — see every build across every environment and give your whole team a safe button to ship and roll back.</p>

      <form class="wl-form" id="waitlist-form"
            hx-post="/waitlist"
            hx-target="#waitlist-result"
            hx-swap="outerHTML"
            hx-disabled-elt="find button">
        <label class="wl-hp" aria-hidden="true">
          Company website<input type="text" name="company_website" tabindex="-1" autocomplete="off" />
        </label>
        <input type="email" name="email" required placeholder="you@team.dev" aria-label="Work email" />
        <button type="submit" class="btn primary">{{ctaSubmit}}</button>
        <input type="hidden" name="elapsedMs" value="" />
        <input type="hidden" name="utm_source" value="" />
        <input type="hidden" name="utm_medium" value="" />
        <input type="hidden" name="utm_campaign" value="" />
        <input type="hidden" name="utm_term" value="" />
        <input type="hidden" name="utm_content" value="" />
        <input type="hidden" name="referrer" value="" />
      </form>
      <div id="waitlist-result"></div>
      <p class="wl-note">No spam. Just your invite and the occasional product update.</p>
    </div>
  </section>

  <footer>
    <div class="wrap foot-in">
      <span>GitLaunch · deployment control your whole team can drive</span>
      <span class="foot-legal">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="mailto:support@gitlaunch.dev">Contact</a>
        <span>© GitLaunch</span>
      </span>
    </div>
  </footer>

</div>

<script>
  (function () {
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var board = document.getElementById('board');
    if (!board) return;

    var busy = {}; // one deploy at a time per column

    function liveBadge(fresh) {
      return '<span class="pill live"><span class="live-dot"></span>' +
        (fresh ? 'Live · just now' : 'Live') + '</span>';
    }
    function setLive(cell) {
      cell.innerHTML = liveBadge(true);
      cell.classList.remove('flash');
      void cell.offsetWidth;           // restart the flash on repeat deploys
      cell.classList.add('flash');
    }
    function setDeploy(cell) {
      cell.innerHTML = '<button class="cbtn" type="button">Deploy</button>';
    }

    // Deploy the build in `cell` to its column's environment: it flips to Live,
    // and whatever was Live in that same column rolls back to a Deploy button.
    function deploy(cell) {
      var col = cell.getAttribute('data-col');
      if (!col || busy[col]) return;
      if (cell.querySelector('.pill.live')) return; // already live here

      var column = board.querySelectorAll('.env-cell[data-col="' + col + '"]');
      function finish() {
        for (var i = 0; i < column.length; i++) {
          if (column[i] !== cell && column[i].querySelector('.pill.live')) {
            setDeploy(column[i]);
          }
        }
        setLive(cell);
        busy[col] = false;
      }

      var btn = cell.querySelector('.cbtn');
      if (reduce || !btn) { finish(); return; }

      busy[col] = true;
      btn.textContent = 'Deploying…';
      btn.disabled = true;
      var prog = document.createElement('div');
      prog.className = 'cprog on';
      prog.innerHTML = '<div class="cprog-fill"></div>';
      cell.appendChild(prog);
      var fill = prog.firstChild;
      requestAnimationFrame(function () { fill.classList.add('go'); });
      setTimeout(finish, 1850);
    }

    // Delegated: every Deploy button (including ones re-created after a deploy)
    // is clickable and keyboard-activatable.
    board.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('.cbtn');
      if (!btn) return;
      var cell = btn.closest('.env-cell');
      if (cell) deploy(cell);
    });

    // One-time auto-demo so first-time visitors see the aha before they click.
    var auto = document.getElementById('autoCell');
    if (auto) setTimeout(function () { deploy(auto); }, 1400);
  })();

  // Waitlist: stamp campaign attribution + fill-time so the server can
  // attribute the lead and filter bots. Bots that skip the page never run this.
  (function () {
    var form = document.getElementById('waitlist-form');
    if (!form) return;

    var loadedAt = Date.now();
    var params = new URLSearchParams(window.location.search);

    function setField(name, value) {
      var el = form.querySelector('[name="' + name + '"]');
      if (el && value != null) el.value = value;
    }

    ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach(function (k) {
      if (params.has(k)) setField(k, params.get(k));
    });
    if (document.referrer) setField('referrer', document.referrer);

    // Persist attribution across an in-session bounce so a later signup keeps
    // its original campaign even after the UTM params leave the URL.
    try {
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach(function (k) {
        if (params.has(k)) sessionStorage.setItem('gl_' + k, params.get(k));
        else if (sessionStorage.getItem('gl_' + k)) setField(k, sessionStorage.getItem('gl_' + k));
      });
    } catch (e) { /* private mode — attribution still works within the page */ }

    // Inject fill-time at request build (canonical HTMX hook — order-safe).
    form.addEventListener('htmx:configRequest', function (evt) {
      evt.detail.parameters['elapsedMs'] = String(Date.now() - loadedAt);
    });
  })();
</script>
