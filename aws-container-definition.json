{
  "family": "launchpad-container-definition",
  "containerDefinitions": [
    {
      "name": "launchpad",
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "entryPoint": ["yarn", "start"],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "launchpad",
          "awslogs-region": "us-east-1",
          "awslogs-create-group": "true",
          "awslogs-stream-prefix": "deploy"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "executionRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/YOUR_ECS_TASK_EXECUTION_ROLE",
  "cpu": "256",
  "memory": "0.5GB",
  "networkMode": "awsvpc"
}
