<!-- Navigation -->
<nav class="fixed w-full bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm border-b border-gray-200 dark:border-gray-800 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center">
      <div class="flex items-center">
        <span class="text-xl font-bold text-gray-900 dark:text-white">GitDeploy</span>
      </div>
      <div class="flex items-center">
        <span class="text-sm text-gray-500 dark:text-gray-400">Setting up your account</span>
      </div>
    </div>
  </div>
</nav>

<!-- Main Content -->
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pt-16">
  <div class="max-w-2xl mx-auto px-4 py-16 sm:py-24">
    <!-- Progress Steps -->
    <div class="mb-12">
      <div style="display: flex; align-items: center; justify-content: center;">
        <div style="display: flex; align-items: center;">
          <!-- Step 1: Current -->
          <div style="display: flex; flex-direction: column; align-items: center;">
            <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;" class="bg-blue-600 rounded-full text-white font-semibold shadow-lg shadow-blue-600/25">
              1
            </div>
            <span class="mt-2 text-sm font-medium text-blue-600">Connect</span>
          </div>

          <div style="width: 80px; height: 4px;" class="bg-gray-200 dark:bg-gray-700 mx-4"></div>

          <!-- Step 2: Pending -->
          <div style="display: flex; flex-direction: column; align-items: center;">
            <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;" class="bg-gray-200 dark:bg-gray-700 rounded-full text-gray-500 dark:text-gray-400 font-semibold">
              2
            </div>
            <span class="mt-2 text-sm text-gray-500 dark:text-gray-400">Select Repos</span>
          </div>

          <div style="width: 80px; height: 4px;" class="bg-gray-200 dark:bg-gray-700 mx-4"></div>

          <!-- Step 3: Pending -->
          <div style="display: flex; flex-direction: column; align-items: center;">
            <div style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;" class="bg-gray-200 dark:bg-gray-700 rounded-full text-gray-500 dark:text-gray-400 font-semibold">
              3
            </div>
            <span class="mt-2 text-sm text-gray-500 dark:text-gray-400">Deploy</span>
          </div>
        </div>
      </div>
    </div>

