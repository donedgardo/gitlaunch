<!-- Jenkins Deployment Pipeline Instructions Partial -->
<!-- Requires: apiUrl, serviceId, firstEnv -->
<div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
  <div class="p-6 sm:p-8">
    <div style="flex: 1; min-width: 0;">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
        Report Deployments from a Jenkins Deploy Pipeline
      </h2>
      <p class="text-gray-600 dark:text-gray-400 mb-4">
        Create a separate parameterized deploy pipeline that reports status as it runs. Save this as your deploy job's <code class="text-xs bg-gray-100 dark:bg-gray-700 px-1.5 py-0.5 rounded">Jenkinsfile</code>:
      </p>
      <div class="relative">
        <div class="bg-gray-900 dark:bg-gray-950 rounded-xl p-4 font-mono text-xs text-green-400 overflow-x-auto">
          <pre class="whitespace-pre"><code>pipeline {
  agent any
  parameters {
    string(name: 'ENVIRONMENT', defaultValue: '{{firstEnv}}', description: 'Environment to deploy to')
    string(name: 'BUILD_ID', defaultValue: '', description: 'Build ID (commit SHA)')
  }
  environment {
    GITLAUNCH_API        = '{{apiUrl}}'
    GITLAUNCH_SERVICE_ID = '{{serviceId}}'
    GITLAUNCH_API_KEY    = credentials('gitlaunch-api-key')
    BUILD_ID_RESOLVED    = "${params.BUILD_ID ?: env.GIT_COMMIT}"
  }
  stages {
    stage('Report deploying') {
      steps {
        sh 'curl -fsS -X PATCH "$GITLAUNCH_API/api/v1/services/$GITLAUNCH_SERVICE_ID/builds/$BUILD_ID_RESOLVED/deploy/$ENVIRONMENT" -H "Authorization: Bearer $GITLAUNCH_API_KEY" -H "Content-Type: application/json" -d \'{"status":"deploying"}\''
      }
    }
    stage('Deploy') {
      steps {
        // ── Add your deploy steps here ──
        sh 'echo "Deploying to $ENVIRONMENT"'
      }
    }
  }
  post {
    success { sh 'curl -fsS -X PATCH "$GITLAUNCH_API/api/v1/services/$GITLAUNCH_SERVICE_ID/builds/$BUILD_ID_RESOLVED/deploy/$ENVIRONMENT" -H "Authorization: Bearer $GITLAUNCH_API_KEY" -H "Content-Type: application/json" -d \'{"status":"deployed"}\'' }
    failure { sh 'curl -fsS -X PATCH "$GITLAUNCH_API/api/v1/services/$GITLAUNCH_SERVICE_ID/builds/$BUILD_ID_RESOLVED/deploy/$ENVIRONMENT" -H "Authorization: Bearer $GITLAUNCH_API_KEY" -H "Content-Type: application/json" -d \'{"status":"error"}\'' }
    aborted { sh 'curl -fsS -X PATCH "$GITLAUNCH_API/api/v1/services/$GITLAUNCH_SERVICE_ID/builds/$BUILD_ID_RESOLVED/deploy/$ENVIRONMENT" -H "Authorization: Bearer $GITLAUNCH_API_KEY" -H "Content-Type: application/json" -d \'{"status":"cancelled"}\'' }
  }
}</code></pre>
        </div>
        <button
          onclick="copyJenkinsDeployCode()"
          class="absolute top-3 right-3 p-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors"
          title="Copy to clipboard"
        >
          <svg id="jenkins_deploy_copy_icon" style="width: 20px; height: 20px;" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
          </svg>
          <svg id="jenkins_deploy_check_icon" style="width: 20px; height: 20px; display: none;" class="text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </button>
      </div>
      <div class="mt-3 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-3">
        <p class="text-xs text-blue-700 dark:text-blue-300">
          Make sure your CI pipeline reported the build first (see the CI snippet above) — the deploy status attaches to that build.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
function copyJenkinsDeployCode() {
  var q = String.fromCharCode(39);
  var patch = function(status) {
    return 'sh ' + q + 'curl -fsS -X PATCH "$GITLAUNCH_API/api/v1/services/$GITLAUNCH_SERVICE_ID/builds/$BUILD_ID_RESOLVED/deploy/$ENVIRONMENT" -H "Authorization: Bearer $GITLAUNCH_API_KEY" -H "Content-Type: application/json" -d \\' + q + '{"status":"' + status + '"}\\' + q + q;
  };
  var code =
    'pipeline {\n' +
    '  agent any\n' +
    '  parameters {\n' +
    "    string(name: 'ENVIRONMENT', defaultValue: '{{firstEnv}}', description: 'Environment to deploy to')\n" +
    "    string(name: 'BUILD_ID', defaultValue: '', description: 'Build ID (commit SHA)')\n" +
    '  }\n' +
    '  environment {\n' +
    "    GITLAUNCH_API        = '{{apiUrl}}'\n" +
    "    GITLAUNCH_SERVICE_ID = '{{serviceId}}'\n" +
    "    GITLAUNCH_API_KEY    = credentials('gitlaunch-api-key')\n" +
    '    BUILD_ID_RESOLVED    = "${params.BUILD_ID ?: env.GIT_COMMIT}"\n' +
    '  }\n' +
    '  stages {\n' +
    "    stage('Report deploying') {\n" +
    '      steps {\n' +
    '        ' + patch('deploying') + '\n' +
    '      }\n' +
    '    }\n' +
    "    stage('Deploy') {\n" +
    '      steps {\n' +
    '        sh "echo \\"Deploying to $ENVIRONMENT\\""\n' +
    '      }\n' +
    '    }\n' +
    '  }\n' +
    '  post {\n' +
    '    success { ' + patch('deployed') + ' }\n' +
    '    failure { ' + patch('error') + ' }\n' +
    '    aborted { ' + patch('cancelled') + ' }\n' +
    '  }\n' +
    '}';
  var copyIcon = document.getElementById('jenkins_deploy_copy_icon');
  var checkIcon = document.getElementById('jenkins_deploy_check_icon');
  navigator.clipboard.writeText(code).then(function() {
    copyIcon.style.display = 'none';
    checkIcon.style.display = 'block';
    setTimeout(function() {
      copyIcon.style.display = 'block';
      checkIcon.style.display = 'none';
    }, 2000);
  });
}
</script>
