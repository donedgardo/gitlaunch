{{#unless canDispatch}}
<div class="max-w-3xl mx-auto px-4 pt-6">
  <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-2xl p-5 mb-6">
    <div style="display: flex; align-items: flex-start; gap: 12px;">
      <svg style="width: 24px; height: 24px; min-width: 24px;" class="text-blue-600 dark:text-blue-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
      </svg>
      <div style="flex: 1; min-width: 0;">
        <h3 class="font-semibold text-blue-800 dark:text-blue-200 mb-1">Finish deploy setup</h3>
        <p class="text-sm text-blue-700 dark:text-blue-300 mb-3">
          This service is reporting builds but can't deploy yet. Connect a deploy target
          — GitHub Actions, Jenkins, or a raw webhook — to launch and roll back from here.
        </p>
        <a href="/onboarding/setup-deploy/{{serviceId}}" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors text-sm">
          Set up deployments
        </a>
      </div>
    </div>
  </div>
</div>
{{/unless}}

{{#if needsDeploymentSetup}}
<div id="build-table">
  <div class="max-w-2xl mx-auto px-4 py-10">
    <!-- Build detected banner -->
    <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-2xl p-6 mb-6">
      <div style="display: flex; align-items: flex-start;">
        <svg style="width: 24px; height: 24px; min-width: 24px;" class="text-green-600 dark:text-green-400 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <div>
          <h3 class="font-semibold text-green-800 dark:text-green-200 mb-1">Build Detected!</h3>
          <p class="text-sm text-green-700 dark:text-green-300">
            Your CI pipeline is reporting builds. Now set up your deploy workflow to start deploying.
          </p>
        </div>
      </div>
    </div>
  </div>

{{> setupStep step=4 totalSteps=5 serviceId=serviceId serviceName=serviceName environments=environments }}
</div>
{{else if builds.length}}
<div id="build-table" class="gl-board" data-service-name="{{serviceName}}">
  <div class="gl-board-bar">
    <span class="gl-dots"><span></span><span></span><span></span></span>
    <span class="gl-path">{{serviceName}} · release board</span>
    <span class="gl-rel">#{{shortSha builds.[0].id}}</span>
  </div>
  <div class="gl-board-scroll">
    <table>
      <thead>
      <tr>
        <th>Commit</th>
        {{#each environments as |env|}}
          <th class="gl-env-col">
            {{env.name}}
            {{#if env.flags.hasFlags}}
              <a
                class="gl-env-flags"
                href="/services/{{../serviceId}}/flags"
                title="{{env.flags.label}} in {{env.name}}{{#if env.flags.detail}} — {{env.flags.detail}}{{/if}}"
              >
                <span class="gl-env-flags-count">{{env.flags.label}}</span>
                {{#if env.flags.detail}}
                  <span class="gl-env-flags-detail">{{env.flags.detail}}</span>
                {{/if}}
              </a>
            {{/if}}
          </th>
        {{/each}}
      </tr>
      </thead>
      <tbody id="build-table-body">
      {{#each builds as |build| }}
        {{> buildRow build=build environments=../environments serviceName=../serviceName repoUrl=../repoUrl serviceId=../serviceId canDispatch=../canDispatch }}
      {{/each}}
      </tbody>
    </table>
  </div>
  {{> paginationControls pagination=pagination serviceName=serviceName}}
</div>
<script>
(function() {
  var serviceName = '{{serviceName}}';
  var eventSource;
  var reconnectDelay = 1000;
  var maxReconnectDelay = 30000;

  function connect() {
    eventSource = new EventSource('/new-build-stream/' + serviceName);

    eventSource.addEventListener('new-build', function(e) {
      reconnectDelay = 1000; // Reset delay on successful message
      var data = JSON.parse(e.data);
      var tbody = document.getElementById('build-table-body');
      if (tbody && data.html) {
        var existingRow = document.getElementById('build-' + data.buildId);
        if (!existingRow) {
          tbody.insertAdjacentHTML('afterbegin', data.html);
          if (typeof htmx !== 'undefined') {
            htmx.process(tbody.firstElementChild);
          }
        }
      }
    });

    eventSource.addEventListener('connected', function() {
      reconnectDelay = 1000; // Reset delay on successful connection
    });

    eventSource.onerror = function() {
      eventSource.close();
      setTimeout(function() {
        reconnectDelay = Math.min(reconnectDelay * 2, maxReconnectDelay);
        connect();
      }, reconnectDelay);
    };
  }

  connect();

  window.addEventListener('beforeunload', function() {
    if (eventSource) {
      eventSource.close();
    }
  });
})();
</script>
{{else}}
<div id="build-table">
  {{> emptyBuilds serviceId=serviceId serviceName=serviceName showSimulateBuild=showSimulateBuild provider=provider apiUrl=apiUrl }}
</div>
{{/if}}