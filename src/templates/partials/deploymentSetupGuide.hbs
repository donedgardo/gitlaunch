<div class="max-w-2xl mx-auto px-4 py-16">
  <!-- State: Builds exist but no deployments configured -->
  <div class="text-center mb-10">
    <div style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;" class="bg-amber-100 dark:bg-amber-900/30 rounded-full mx-auto mb-6">
      <svg style="width: 40px; height: 40px;" class="text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
      </svg>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">
      Configure Deployment Workflow
    </h1>
    <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
      Your builds are being tracked! Now let's set up the deployment workflow.
    </p>
  </div>

  <!-- Step 1: Select Workflow -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
    <div class="p-6 sm:p-8">
      <div style="display: flex; align-items: flex-start;">
        <div style="width: 32px; height: 32px; min-width: 32px; display: flex; align-items: center; justify-content: center;" class="bg-blue-600 text-white rounded-full font-semibold mr-4">
          1
        </div>
        <div style="flex: 1;">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
            Select Deployment Workflow
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            Choose the GitHub Actions workflow that handles deployments:
          </p>
          <form action="/services/{{serviceId}}/configure-workflow" method="POST">
            <div class="space-y-4">
              <div>
                <label for="workflowFile" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Workflow File
                </label>
                <select
                  id="workflowFile"
                  name="workflowFile"
                  class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  hx-get="/services/{{serviceId}}/workflows"
                  hx-trigger="load"
                  hx-swap="innerHTML"
                >
                  <option value="">Loading workflows...</option>
                </select>
              </div>

              <div>
                <label for="eventType" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Event Type
                </label>
                <input
                  type="text"
                  id="eventType"
                  name="eventType"
                  value="deployment"
                  placeholder="e.g., deployment, deploy-staging"
                  class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                />
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                  The repository_dispatch event type your workflow listens for
                </p>
              </div>

              <button
                type="submit"
                class="w-full px-6 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors shadow-lg shadow-blue-600/25"
              >
                Save Configuration
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Step 2: Workflow Setup Guide -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
    <div class="p-6 sm:p-8">
      <div style="display: flex; align-items: flex-start;">
        <div style="width: 32px; height: 32px; min-width: 32px; display: flex; align-items: center; justify-content: center;" class="bg-gray-400 text-white rounded-full font-semibold mr-4">
          2
        </div>
        <div style="flex: 1;">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
            Workflow Configuration
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            Your workflow should listen for <code class="bg-gray-100 dark:bg-gray-700 px-1 rounded">repository_dispatch</code> events:
          </p>
          <div class="relative">
            <div class="bg-gray-900 dark:bg-gray-950 rounded-xl p-4 font-mono text-sm text-green-400 overflow-x-auto">
              <pre><code>on:
  repository_dispatch:
    types: [deployment]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Deploy to $&#123;&#123; github.event.client_payload.environment &#125;&#125;
        run: |
          echo "Deploying build $&#123;&#123; github.event.client_payload.buildId &#125;&#125;"
          echo "to $&#123;&#123; github.event.client_payload.environment &#125;&#125;"</code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Documentation Link -->
  <div class="text-center">
    <a
      href="/docs"
      class="inline-flex items-center px-6 py-3 text-blue-600 dark:text-blue-400 font-semibold hover:underline"
    >
      <svg style="width: 20px; height: 20px; min-width: 20px;" class="mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
      </svg>
      View Documentation
    </a>
  </div>
</div>
