{{#if publishable}}
  <div class="bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-lg p-4">
    <p class="text-sm font-semibold text-emerald-800 dark:text-emerald-200 mb-1">Save this key — shown once</p>
    <p class="text-xs text-emerald-700 dark:text-emerald-300 mb-3">
      Publishable (<code>flags:evaluate</code>). Safe to ship in your frontend: it can only evaluate this service's
      <code>{{evaluateEnv}}</code> flags and record conversions against them, and only from {{allowedOrigins}}.
      It cannot read flag configuration, targeting rules, or experiment results.
    </p>

    <div class="relative mb-3">
      <div id="flag-new-key" class="bg-gray-900 rounded-lg p-3 pr-16 font-mono text-xs text-green-400 break-all">{{newKey}}</div>
      <button type="button" onclick="copyFlagSnippet('flag-new-key', this)"
        class="absolute top-2 right-2 px-2 py-1 text-xs bg-gray-800 hover:bg-gray-700 text-gray-300 rounded">Copy</button>
    </div>

    <label class="block text-xs font-medium uppercase tracking-wide text-emerald-700 dark:text-emerald-300 mb-1">Use it in the browser</label>
    <div class="relative">
      <pre class="bg-gray-900 rounded-lg p-3 pr-16 text-xs text-green-400 overflow-x-auto"><code id="flag-snippet">import &#123; createFlagClient &#125; from "@gitlaunch/flags";

const flags = createFlagClient(&#123;
  apiUrl: "{{apiUrl}}",
  serviceId: "{{serviceId}}",
  environment: "{{evaluateEnv}}",
  apiKey: "{{newKey}}",
{{#if bundleUrl}}  bundleUrl: "{{bundleUrl}}",
{{/if}}&#125;);

// VISITOR_ID must be stable for a visitor, or they'll flip between variants.
const variant = await flags.variant("my-flag", &#123; entity: VISITOR_ID &#125;, "control");
await flags.track("my-flag", &#123; entity: VISITOR_ID, goal: "signup" &#125;);</code></pre>
      <button type="button" onclick="copyFlagSnippet('flag-snippet', this)"
        class="absolute top-2 right-2 px-2 py-1 text-xs bg-gray-800 hover:bg-gray-700 text-gray-300 rounded">Copy</button>
    </div>

    <p class="mt-2 text-xs text-emerald-700 dark:text-emerald-300">
      The origin allow-list stops this key being reused on another site from a browser. It is not a secret —
      anyone can read it from your bundle — so never widen it beyond evaluating flags.
    </p>
  </div>
{{else}}
  <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg p-4">
    <p class="text-sm font-semibold text-amber-800 dark:text-amber-200 mb-1">Save this key — shown once</p>
    <p class="text-xs text-amber-700 dark:text-amber-300 mb-3">
      Secret (<code>flags:read</code>). It can read this account's flag configuration, targeting rules and
      experiment results — store it as a server-side secret. Never put it in a browser or mobile app; for that,
      create a publishable key instead.
    </p>

    <div class="relative mb-3">
      <div id="flag-new-key" class="bg-gray-900 rounded-lg p-3 pr-16 font-mono text-xs text-green-400 break-all">{{newKey}}</div>
      <button type="button" onclick="copyFlagSnippet('flag-new-key', this)"
        class="absolute top-2 right-2 px-2 py-1 text-xs bg-gray-800 hover:bg-gray-700 text-gray-300 rounded">Copy</button>
    </div>

    <label class="block text-xs font-medium uppercase tracking-wide text-amber-700 dark:text-amber-300 mb-1">Try it</label>
    <div class="relative">
      <pre class="bg-gray-900 rounded-lg p-3 pr-16 text-xs text-green-400 overflow-x-auto"><code id="flag-curl">curl -H "Authorization: Bearer {{newKey}}" \
  "{{apiUrl}}/api/v1/services/{{serviceId}}/environments/{{evaluateEnv}}/flags/evaluate?entity=USER_ID"</code></pre>
      <button type="button" onclick="copyFlagSnippet('flag-curl', this)"
        class="absolute top-2 right-2 px-2 py-1 text-xs bg-gray-800 hover:bg-gray-700 text-gray-300 rounded">Copy</button>
    </div>
  </div>
{{/if}}
