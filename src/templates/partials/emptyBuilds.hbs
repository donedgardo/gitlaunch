<div class="max-w-2xl mx-auto px-4 py-16">
  {{#if serviceId}}
  <!-- State B: Service selected, no builds - show getting started wizard -->
  <div class="text-center mb-10">
    <div style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;" class="bg-blue-100 dark:bg-blue-900/30 rounded-full mx-auto mb-6">
      <svg style="width: 40px; height: 40px;" class="text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
      </svg>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">
      Get Your First Build
    </h1>
  </div>


  <!-- Same offer as onboarding: hand the setup to an agent, or do it by hand.
       A service created before this existed reaches it here. -->
  {{> aiAgentSetup apiUrl=apiUrl serviceId=serviceId}}

  <!-- Report your first build — guide matches this service's CI provider -->
  {{#if (eq provider "jenkins")}}
    {{> jenkinsBuildReportingGuide apiUrl=apiUrl serviceId=serviceId }}
  {{else}}
    {{#if (eq provider "raw")}}
    <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg p-6 sm:p-8 mb-6">
      {{> rawBuildReportingGuide apiUrl=apiUrl serviceId=serviceId }}
    </div>
    {{else}}
      {{> githubSecretsSetup serviceId=serviceId idPrefix="empty_" showCopyButton=true }}
      {{> buildReportingInstructions idPrefix="empty_" }}
    {{/if}}
  {{/if}}

  {{#if showSimulateBuild}}
  <div class="bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-800 rounded-2xl p-6 mb-6">
    <div style="display: flex; align-items: flex-start;">
      <svg style="width: 24px; height: 24px; min-width: 24px;" class="text-purple-600 dark:text-purple-400 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
      </svg>
      <div style="flex: 1;">
        <h3 class="font-semibold text-purple-800 dark:text-purple-200 mb-1">Dev Mode</h3>
        <p class="text-sm text-purple-700 dark:text-purple-300 mb-3">Simulate a build to see how the dashboard works without a real CI pipeline.</p>
        <div style="display: flex; gap: 8px; align-items: flex-end;">
          <div style="flex: 1;">
            <label for="simulate-api-key" class="block text-xs font-medium text-purple-700 dark:text-purple-300 mb-1">API Key</label>
            <input type="text" id="simulate-api-key" placeholder="sk_..."
              class="w-full px-3 py-2 border border-purple-300 dark:border-purple-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white text-sm font-mono focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
          </div>
          <button id="simulate-build-btn" onclick="simulateBuild()"
            class="px-4 py-2 bg-purple-600 text-white font-medium rounded-lg hover:bg-purple-700 transition-colors text-sm whitespace-nowrap">
            Simulate Build
          </button>
        </div>
        <span id="simulate-build-status" class="mt-2 block text-sm text-purple-600 dark:text-purple-400" style="display: none;"></span>
      </div>
    </div>
  </div>
  <script>
  function simulateBuild() {
    var btn = document.getElementById('simulate-build-btn');
    var status = document.getElementById('simulate-build-status');
    var apiKey = document.getElementById('simulate-api-key').value.trim();
    if (!apiKey) { status.textContent = 'Enter an API key first'; status.style.display = 'block'; return; }
    var buildId = 'sim-' + Date.now();
    btn.disabled = true; btn.textContent = 'Reporting...'; status.style.display = 'none';
    fetch('/api/v1/services/{{serviceId}}/builds', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + apiKey, 'Content-Type': 'application/json' },
      body: JSON.stringify({ buildId: buildId, message: 'Simulated build from GitLaunch' })
    })
    .then(function(res) { if (!res.ok) throw new Error(res.status); return res.json(); })
    .then(function(data) { status.textContent = 'Build ' + (data.buildId || buildId) + ' reported!'; status.style.display = 'block'; })
    .catch(function() { btn.textContent = 'Simulate Build'; btn.disabled = false; status.textContent = 'Failed — check your API key'; status.style.display = 'block'; });
  }
  </script>
  {{/if}}

  <!-- Reload as soon as the first build lands -->
  <script>
  (function() {
    var es = new EventSource('/build-created-stream/{{serviceId}}');
    es.addEventListener('build:created', function() { es.close(); window.location.reload(); });
    es.onerror = function() { es.close(); };
  })();
  </script>

  {{else}}
  <!-- State A: No services - show create service CTA -->
  <div class="text-center">
    <div style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;" class="bg-gray-100 dark:bg-gray-700 rounded-full mx-auto mb-6">
      <svg style="width: 40px; height: 40px;" class="text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
      </svg>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
      Create Your First Service
    </h1>
    <p class="text-lg text-gray-600 dark:text-gray-400 mb-8 max-w-md mx-auto">
      A service represents an application or microservice you want to track deployments for.
    </p>
    <a
      href="/services/new"
      class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors shadow-lg shadow-blue-600/25"
    >
      <svg style="width: 20px; height: 20px; min-width: 20px;" class="mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      Create Service
    </a>
  </div>
  {{/if}}
</div>
