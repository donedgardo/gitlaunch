{{#if doraMetrics}}
<div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-5">
  <div class="flex items-baseline justify-between mb-4">
    <h3 class="font-semibold text-gray-900 dark:text-gray-100">Deployment history</h3>
    {{#if doraMetrics.history.length}}
    <span class="text-xs text-gray-500 dark:text-gray-400">last {{doraMetrics.historyLimit}} deployments</span>
    {{/if}}
  </div>

  {{#if doraMetrics.history.length}}
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">
          <th class="font-medium py-2 pr-4">Build</th>
          <th class="font-medium py-2 pr-4">Environment</th>
          <th class="font-medium py-2 pr-4">Outcome</th>
          <th class="font-medium py-2 pr-4">Took</th>
          <th class="font-medium py-2">When</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
        {{#each doraMetrics.history}}
        <tr>
          <td class="py-2 pr-4 font-mono text-xs text-gray-700 dark:text-gray-300">{{shortSha this.buildId}}</td>
          <td class="py-2 pr-4 text-gray-700 dark:text-gray-300">{{this.environment}}</td>
          <td class="py-2 pr-4">
            <span
              class="inline-flex items-center gap-1.5 text-xs px-2 py-0.5 rounded-full
                {{#if this.failed}}bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-300
                {{else if this.inFlight}}bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300
                {{else}}bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300{{/if}}"
            >{{this.statusLabel}}</span>
            {{#if this.isRollback}}
            <span
              class="ml-1.5 inline-flex items-center text-xs px-2 py-0.5 rounded-full bg-amber-50 dark:bg-amber-900/20 text-amber-800 dark:text-amber-300"
              title="This deployment put an earlier build back"
            >Rollback</span>
            {{/if}}
          </td>
          <td class="py-2 pr-4 text-gray-500 dark:text-gray-400 tabular-nums">{{this.duration}}</td>
          <td class="py-2 text-gray-500 dark:text-gray-400 whitespace-nowrap">{{timeAgo this.at}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <p class="text-xs text-gray-400 dark:text-gray-500 mt-4">
    Every dispatch this service recorded, including the ones that failed. A redeploy of the same
    build is its own line — the try it replaced stays on the record.
  </p>
  {{else}}
  <p class="text-sm text-gray-500 dark:text-gray-400">
    Nothing has been deployed yet. The first deployment shows up here as soon as it is reported.
  </p>
  {{/if}}
</div>
{{/if}}
