# Server
PUBLIC_URL="http://localhost:3050"
PORT=3050

# License key, used only by the self-hosted distribution build. Whether a build
# is self-hosted, and which issuer key it trusts, are compiled in — see
# src/services/licensing/distribution.ts. Ignored by this (hosted) build.
GITLAUNCH_LICENSE_KEY=

# Database
MONGODB_URI="mongodb://localhost:27017"

# Session
COOKIE_SECRET_SIGNATURE=your-secret-key-here

# Encryption at rest for stored secrets (e.g. Jenkins API tokens).
# Each key must be 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
#
# Single key (simplest):
ENCRYPTION_KEY=
#
# To rotate keys without stranding existing ciphertexts, use a keyring instead:
# list every key as "<id>:<base64key>" (comma-separated) and name the current
# one. New data is encrypted with the primary; old keys stay for decryption.
# ENCRYPTION_KEYS=2026a:BASE64KEY_A,2026b:BASE64KEY_B
# ENCRYPTION_PRIMARY_KEY_ID=2026b

# Dev mode — use fake GitHub services (no real OAuth/App needed)
USE_FAKE_GITHUB=false

# Google OAuth (optional sign-in method).
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {PUBLIC_URL}/auth/google/callback
# Leave GOOGLE_CLIENT_ID blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev mode — use a fake Google user (no real OAuth app needed)
USE_FAKE_GOOGLE=false

# Transactional email for email/password confirmation links.
# Easiest to set up on your own domain: https://resend.com (add domain, set the
# SPF/DKIM DNS records, done). Without these, confirmation emails are logged to
# the console instead of sent (fine for local dev).
RESEND_API_KEY=
# Verified sender, e.g. "GitLaunch <noreply@yourdomain.com>"
EMAIL_FROM=

# Dev tool — show a "Simulate Build" button (onboarding, dashboard, setup) that
# reports a fake build so you can exercise the flow without a real CI pipeline.
ENABLE_BUILD_SIMULATION=false

# GitHub App (create at https://github.com/settings/apps/new)
GH_APP_ID=
GH_APP_CLIENT_ID=
GH_APP_CLIENT_SECRET=
GH_APP_WEBHOOK_SECRET=
# Use scripts/add-private-key.sh to add this from your .pem file
GH_APP_PRIVATE_KEY=
# GitHub App name (for install URL generation)
GH_APP_NAME=

# Stripe (for billing)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_TEAM_PRICE_ID=price_xxx

# Error reporting (optional). Set a DSN and the Sentry SDK is registered at
# boot; errors thrown while handling a request are reported automatically.
# Leave blank and nothing is loaded or sent. Requires `yarn add @sentry/node`
# when set — without the package the app logs a warning and carries on.
SENTRY_DSN=
# Optional: label events by deploy target. Defaults to NODE_ENV.
# SENTRY_ENVIRONMENT=production
# Optional: tie events to a build so stack traces map to a known commit.
# SENTRY_RELEASE=gitlaunch@1.0.0
# Optional: performance tracing sample rate (0..1). Unset = tracing off.
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Feature flags (optional): shared Redis cache for flag evaluation across
# instances. Leave blank to use an in-memory per-instance cache. Requires
# `yarn add ioredis` when set.
REDIS_URL=

# Product Analytics warehouse — persist product events (deploys, logins, etc.)
# into MongoDB for the internal analytics dashboard at /dashboard/analytics.
# When false (default), analytics log to the console (dev) or no-op.
ANALYTICS_WAREHOUSE=false
# Optional: auto-expire raw analytics events after N days (TTL index). Unset = keep forever.
# ANALYTICS_RETENTION_DAYS=90
# Optional: keep our own traffic out of acquisition and usage reporting. Unset
# = nothing is treated as internal (every event counts, as before).
# Addresses or whole domains (@example.com). A matching waitlist signup is still
# captured as a lead; its event is stamped internal so reports can drop it.
# ANALYTICS_INTERNAL_EMAILS=you@example.com,@yourcompany.com
# Literal distinctIds — a gl_vid visitor cookie or a user ObjectId. Applied at
# query time, so it also excludes events already in the warehouse.
# ANALYTICS_INTERNAL_ACTORS=6a68137ad9bee0edf44fa114

# GitLaunch's own service within its own platform — the scope its self-hosted
# feature flags live under (GitLaunch dogfooding its own flag service). Shared by
# every internal feature that reads a flag; today that's the waitlist landing
# A/B test (`waitlist-hero-copy`), but more may follow. Get the id from the flags
# page URL: /services/<this>/flags. The owning account is derived from it — no
# account id needed. Leave blank to disable flag reads (control behavior
# everywhere — no exposure/conversion tracking).
GITLAUNCH_SERVICE_ID=
GITLAUNCH_FLAG_ENV=prod
