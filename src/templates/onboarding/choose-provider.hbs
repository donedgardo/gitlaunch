<!-- Navigation -->
<nav class="fixed w-full bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm border-b border-gray-200 dark:border-gray-800 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center">
      <div class="flex items-center">
        <span class="text-xl font-bold text-gray-900 dark:text-white">GitLaunch</span>
      </div>
      <div class="flex items-center">
        <span class="text-sm text-gray-500 dark:text-gray-400">Setting up your account</span>
      </div>
    </div>
  </div>
</nav>

<!-- Main Content -->
<div class="min-h-screen bg-gray-50 dark:bg-gray-900 pt-16">
  <div class="max-w-3xl mx-auto px-4 py-16 sm:py-24">
    <div class="text-center mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">
        How do you deploy?
      </h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
        Choose a CI provider to connect. You can add the other one later.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <!-- GitHub Actions -->
      <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg p-8 flex flex-col">
        <div style="width: 64px; height: 64px;" class="bg-gray-100 dark:bg-gray-700 rounded-2xl flex items-center justify-center mb-6">
          <svg style="width: 32px; height: 32px;" class="text-gray-900 dark:text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </div>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">GitHub Actions</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-6 flex-1">
          Install the GitLaunch GitHub App to trigger workflows and deploy from your repositories.
        </p>
        <a
          href="{{installUrl}}"
          class="inline-flex items-center justify-center w-full px-6 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors"
        >
          Install GitHub App
        </a>
      </div>

      <!-- Jenkins -->
      <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg p-8 flex flex-col">
        <div style="width: 64px; height: 64px;" class="bg-gray-100 dark:bg-gray-700 rounded-2xl flex items-center justify-center mb-6">
          <svg style="width: 32px; height: 32px;" class="text-gray-900 dark:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Jenkins</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-6 flex-1">
          Connect a Jenkins server to report builds and deploy jobs. No GitHub App required.
        </p>
        {{#if jenkinsConnected}}
        <a
          href="/services/new"
          class="inline-flex items-center justify-center w-full px-6 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors"
        >
          Create a service
        </a>
        {{else}}
        <a
          href="/settings/jenkins"
          class="inline-flex items-center justify-center w-full px-6 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors"
        >
          Connect Jenkins
        </a>
        {{/if}}
      </div>
    </div>
  </div>
</div>
