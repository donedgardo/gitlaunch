<tr id="build-{{build.id}}" class="hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
  <td class="px-4 py-3">
    <a
      class="font-mono text-sm text-blue-600 dark:text-blue-400 hover:underline"
      href="{{getBuildCommitLink githubFullName build.id}}"
      target="_blank"
      title="{{build.id}}"
    >
      {{shortSha build.id}}
    </a>
  </td>
  {{#each build.environments as |env|}}
    {{> buildEnvironmentAction
      buildId=../build.id
      env=env.name
      serviceName=../build.serviceName
      serviceId=../build.serviceId
      status=(getStatus ../build env.name)
    }}
  {{/each}}
</tr>