<!-- GitHub Secrets Setup Partial -->
<!-- Required: serviceId -->
<!-- Optional: idPrefix (for unique element IDs), stepNumber, showApiKeyNote, showCopyButton -->
<div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
  <div class="p-6 sm:p-8">
    <div style="display: flex; align-items: flex-start;">
      {{#if stepNumber}}
      <div style="width: 32px; height: 32px; min-width: 32px; display: flex; align-items: center; justify-content: center;" class="bg-blue-600 text-white rounded-full font-semibold mr-4">
        {{stepNumber}}
      </div>
      {{/if}}
      <div style="flex: 1;">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
          Add Secrets to GitHub
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          Add these to your repository secrets and variables:
        </p>
        <div class="space-y-3">
          <div class="bg-gray-50 dark:bg-gray-700/50 rounded-xl p-4">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Repository Secret</span>
              {{#if showRequired}}
              <span class="px-2 py-0.5 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 text-xs font-medium rounded">Required</span>
              {{/if}}
            </div>
            <code class="text-sm text-blue-600 dark:text-blue-400 font-mono">GITLAUNCH_API_KEY</code>
            <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
              {{#if showApiKeyNote}}
              Paste the API key shown above
              {{else}}
              Use the API key from onboarding, or generate a new one in Settings
              {{/if}}
            </p>
          </div>
          <div class="bg-gray-50 dark:bg-gray-700/50 rounded-xl p-4">
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Repository Variable</span>
              {{#if showRequired}}
              <span class="px-2 py-0.5 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 text-xs font-medium rounded">Required</span>
              {{/if}}
            </div>
            <code class="text-sm text-blue-600 dark:text-blue-400 font-mono">GITLAUNCH_SERVICE_ID</code>
            <div class="mt-2 bg-gray-900 dark:bg-gray-950 rounded-lg p-3 font-mono text-sm text-green-400 flex items-center justify-between">
              <span id="{{idPrefix}}service-id">{{serviceId}}</span>
              {{#if showCopyButton}}
              <button
                onclick="copy{{idPrefix}}ServiceId()"
                class="p-1 hover:bg-gray-800 rounded transition-colors"
                title="Copy service ID"
              >
                <svg id="{{idPrefix}}service-copy-icon" style="width: 16px; height: 16px;" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
                <svg id="{{idPrefix}}service-check-icon" style="width: 16px; height: 16px; display: none;" class="text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </button>
              {{/if}}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{{#if showCopyButton}}
<script>
function copy{{idPrefix}}ServiceId() {
  const serviceId = document.getElementById('{{idPrefix}}service-id').textContent.trim();
  navigator.clipboard.writeText(serviceId).then(() => {
    const copyIcon = document.getElementById('{{idPrefix}}service-copy-icon');
    const checkIcon = document.getElementById('{{idPrefix}}service-check-icon');
    copyIcon.style.display = 'none';
    checkIcon.style.display = 'block';
    setTimeout(() => {
      copyIcon.style.display = 'block';
      checkIcon.style.display = 'none';
    }, 2000);
  });
}
</script>
{{/if}}
