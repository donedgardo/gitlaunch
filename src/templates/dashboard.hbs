{{> navigation }}
<main
  id="main"
  class="p-6"
  hx-ext="sse"
  sse-connect="/build-update-stream"
>
  {{#if paymentFailed}}
  <div class="mb-4 p-4 bg-red-50 dark:bg-red-950 border-l-4 border-red-500 text-red-900 dark:text-gray-200">
    <div class="flex items-center">
      <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
      </svg>
      <div>
        {{#if gracePeriodDaysRemaining}}
        <strong>Payment failed. Please update your payment method within {{gracePeriodDaysRemaining}} days to avoid service interruption.</strong>
        {{else}}
        <strong>Payment failed. Your access is restricted. Please update your payment method to restore access.</strong>
        {{/if}}
        <a href="/settings/billing" class="underline ml-2">Update payment method</a>
      </div>
    </div>
  </div>
  {{else if trialDaysRemaining}}
  <div class="mb-4 p-4 bg-yellow-50 dark:bg-yellow-900/20 border-l-4 border-yellow-400 text-yellow-800 dark:text-yellow-200">
    <div class="flex items-center">
      <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
      </svg>
      <div>
        <strong>Trial: {{trialDaysRemaining}} days remaining.</strong>
        <a href="/settings/billing" class="underline ml-2">Subscribe to keep your plan</a>
      </div>
    </div>
  </div>
  {{else if isReadOnly}}
  <div class="mb-4 p-4 bg-red-50 dark:bg-red-950 border-l-4 border-red-400 text-red-800 dark:text-gray-200">
    <div class="flex items-center">
      <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
      </svg>
      <div>
        <strong>Your account exceeds Free plan limits.</strong>
        <span class="ml-2">Resources are read-only.</span>
        <a href="/settings/billing" class="underline ml-2">Upgrade to restore full access</a>
      </div>
    </div>
  </div>
  {{/if}}

  {{> doraPanel }}
  {{> buildTable serviceName=activeService }}
</main>