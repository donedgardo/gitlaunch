<div class="max-w-2xl mx-auto px-4 py-16">
  {{#if serviceId}}
  <!-- State B: Service selected, no builds - show getting started guide -->
  <div class="text-center mb-10">
    <div style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;" class="bg-blue-100 dark:bg-blue-900/30 rounded-full mx-auto mb-6">
      <svg style="width: 40px; height: 40px;" class="text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
      </svg>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">
      Get Your First Build
    </h1>
    <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
      Follow these steps to start tracking deployments
    </p>
  </div>

  {{#if newApiKey}}
  <!-- API Key - shown once after service creation -->
  <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-2xl p-6 mb-6">
    <div style="display: flex; align-items: flex-start;">
      <svg style="width: 24px; height: 24px; min-width: 24px;" class="text-amber-600 dark:text-amber-400 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
      <div style="flex: 1;">
        <h3 class="font-semibold text-amber-800 dark:text-amber-200 mb-1">Save Your API Key Now</h3>
        <p class="text-sm text-amber-700 dark:text-amber-300 mb-3">
          This key will only be shown once. You can generate a new one in <a href="/settings/api-keys" class="underline font-medium">API Keys settings</a>.
        </p>
        <div class="relative">
          <div id="new-api-key" class="bg-gray-900 rounded-xl p-4 font-mono text-sm text-green-400 break-all pr-12">{{newApiKey}}</div>
          <button onclick="copyNewApiKey()" class="absolute top-3 right-3 p-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors" title="Copy API key">
            <svg id="new-key-copy-icon" style="width: 20px; height: 20px;" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
            <svg id="new-key-check-icon" style="width: 20px; height: 20px; display: none;" class="text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <script>
  function copyNewApiKey() {
    var key = document.getElementById('new-api-key').textContent.trim();
    navigator.clipboard.writeText(key).then(function() {
      document.getElementById('new-key-copy-icon').style.display = 'none';
      document.getElementById('new-key-check-icon').style.display = 'block';
      setTimeout(function() {
        document.getElementById('new-key-copy-icon').style.display = 'block';
        document.getElementById('new-key-check-icon').style.display = 'none';
      }, 2000);
    });
  }
  </script>
  {{/if}}

  <!-- Step 1: Add Secrets -->
  {{> githubSecretsSetup serviceId=serviceId idPrefix="empty_" stepNumber="1" }}

  <!-- Step 2: Update CI Workflow -->
  {{> buildReportingInstructions idPrefix="empty_" stepNumber="2" }}

  <!-- Step 3: Push a Commit -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
    <div class="p-6 sm:p-8">
      <div style="display: flex; align-items: flex-start;">
        <div style="width: 32px; height: 32px; min-width: 32px; display: flex; align-items: center; justify-content: center;" class="bg-blue-600 text-white rounded-full font-semibold mr-4">
          3
        </div>
        <div style="flex: 1;">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
            Push a Commit
          </h2>
          <p class="text-gray-600 dark:text-gray-400">
            Your builds will appear here automatically once your CI workflow runs.
          </p>
        </div>
      </div>
    </div>
  </div>

  {{#if showSimulateBuild}}
  <!-- Dev mode: Simulate a build -->
  <div class="bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-800 rounded-2xl p-6 mb-6">
    <div style="display: flex; align-items: flex-start;">
      <svg style="width: 24px; height: 24px; min-width: 24px;" class="text-purple-600 dark:text-purple-400 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
      </svg>
      <div style="flex: 1;">
        <h3 class="font-semibold text-purple-800 dark:text-purple-200 mb-1">Dev Mode</h3>
        <p class="text-sm text-purple-700 dark:text-purple-300 mb-3">
          Simulate a build to see how the dashboard works without a real CI pipeline.
        </p>
        <div style="display: flex; gap: 8px; align-items: flex-end;">
          <div style="flex: 1;">
            <label for="simulate-api-key" class="block text-xs font-medium text-purple-700 dark:text-purple-300 mb-1">API Key</label>
            <input type="text" id="simulate-api-key" placeholder="pk_..." value="{{newApiKey}}"
              class="w-full px-3 py-2 border border-purple-300 dark:border-purple-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white text-sm font-mono focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
          </div>
          <button
            id="simulate-build-btn"
            onclick="simulateBuild()"
            class="px-4 py-2 bg-purple-600 text-white font-medium rounded-lg hover:bg-purple-700 transition-colors text-sm whitespace-nowrap"
          >
            Simulate Build
          </button>
        </div>
        <span id="simulate-build-status" class="mt-2 block text-sm text-purple-600 dark:text-purple-400" style="display: none;"></span>
      </div>
    </div>
  </div>
  <script>
  function simulateBuild() {
    var btn = document.getElementById('simulate-build-btn');
    var status = document.getElementById('simulate-build-status');
    var apiKey = document.getElementById('simulate-api-key').value.trim();

    if (!apiKey) {
      status.textContent = 'Enter an API key first';
      status.style.display = 'block';
      return;
    }

    var buildId = 'sim-' + Date.now();
    btn.disabled = true;
    btn.textContent = 'Reporting...';
    status.style.display = 'none';

    fetch('/api/v1/services/{{serviceId}}/builds', {
      method: 'POST',
      headers: {
        'Authorization': 'Bearer ' + apiKey,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ buildId: buildId })
    })
    .then(function(res) {
      if (!res.ok) throw new Error(res.status);
      return res.json();
    })
    .then(function(data) {
      btn.textContent = 'Simulate Build';
      btn.disabled = false;
      status.textContent = 'Build ' + (data.buildId || buildId) + ' reported!';
      status.style.display = 'block';
    })
    .catch(function(err) {
      btn.textContent = 'Simulate Build';
      btn.disabled = false;
      status.textContent = 'Failed — check your API key';
      status.style.display = 'block';
    });
  }
  </script>
  {{/if}}

  <!-- Listen for first build via SSE -->
  {{#if serviceId}}
  <script>
  (function() {
    var eventSource = new EventSource('/build-created-stream/{{serviceId}}');
    eventSource.addEventListener('build:created', function(e) {
      eventSource.close();
      window.location.reload();
    });
    eventSource.onerror = function() {
      eventSource.close();
    };
  })();
  </script>
  {{/if}}

  <!-- Documentation Link -->
  <div class="text-center">
    <a
      href="/docs"
      class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors shadow-lg shadow-blue-600/25"
    >
      <svg style="width: 20px; height: 20px; min-width: 20px;" class="mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
      </svg>
      View Documentation
    </a>
  </div>

  {{else}}
  <!-- State A: No services - show create service CTA -->
  <div class="text-center">
    <div style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;" class="bg-gray-100 dark:bg-gray-700 rounded-full mx-auto mb-6">
      <svg style="width: 40px; height: 40px;" class="text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
      </svg>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
      Create Your First Service
    </h1>
    <p class="text-lg text-gray-600 dark:text-gray-400 mb-8 max-w-md mx-auto">
      A service represents an application or microservice you want to track deployments for.
    </p>
    <a
      href="/services/new"
      class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors shadow-lg shadow-blue-600/25"
    >
      <svg style="width: 20px; height: 20px; min-width: 20px;" class="mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      Create Service
    </a>
  </div>
  {{/if}}
</div>
