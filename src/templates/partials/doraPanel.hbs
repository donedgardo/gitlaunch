{{#if doraMetrics}}
<div class="max-w-5xl mx-auto px-4 pt-6">
  <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-5 mb-6">
    <div class="flex items-baseline justify-between mb-4">
      <h3 class="font-semibold text-gray-900 dark:text-gray-100">Delivery metrics</h3>
      <span class="text-xs text-gray-500 dark:text-gray-400">last {{doraMetrics.windowDays}} days</span>
    </div>

    {{#each doraMetrics.environments}}
    <div class="mb-5 last:mb-0">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">{{this.name}}</span>
        {{#if this.lowConfidence}}
        <span
          class="text-xs px-2 py-0.5 rounded-full bg-yellow-50 dark:bg-yellow-900/20 text-yellow-800 dark:text-yellow-300"
          title="Too few deployments to read these as a trend"
        >n={{this.sample.deployments}}</span>
        {{/if}}
      </div>

      {{#if this.hasData}}
      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="rounded-lg bg-gray-50 dark:bg-gray-800/60 px-3 py-2">
          <dt class="text-xs text-gray-500 dark:text-gray-400">Deploy frequency</dt>
          <dd class="text-lg font-semibold text-gray-900 dark:text-gray-100">{{this.deploymentFrequency}}</dd>
        </div>
        <div class="rounded-lg bg-gray-50 dark:bg-gray-800/60 px-3 py-2">
          <dt class="text-xs text-gray-500 dark:text-gray-400">Lead time</dt>
          <dd class="text-lg font-semibold text-gray-900 dark:text-gray-100">{{this.leadTime}}</dd>
        </div>
        <div class="rounded-lg bg-gray-50 dark:bg-gray-800/60 px-3 py-2">
          <dt class="text-xs text-gray-500 dark:text-gray-400">Change failure rate</dt>
          <dd class="text-lg font-semibold text-gray-900 dark:text-gray-100">{{this.changeFailureRate}}</dd>
        </div>
        <div class="rounded-lg bg-gray-50 dark:bg-gray-800/60 px-3 py-2">
          <dt class="text-xs text-gray-500 dark:text-gray-400">Time to restore</dt>
          <dd class="text-lg font-semibold text-gray-900 dark:text-gray-100">{{this.timeToRestore}}</dd>
        </div>
      </dl>
      {{else}}
      <p class="text-sm text-gray-500 dark:text-gray-400">No deployments yet</p>
      {{/if}}
    </div>
    {{/each}}

    <p class="text-xs text-gray-400 dark:text-gray-500 mt-4">
      Measured from this service's own deployment history — rollbacks are recorded, not inferred.
      Lead time is measured from when the build was reported.
    </p>
  </div>
</div>
{{/if}}
