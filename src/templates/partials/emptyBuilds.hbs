<div class="max-w-2xl mx-auto px-4 py-16">
  {{#if serviceId}}
  <!-- State B: Service selected, no builds - show getting started guide -->
  <div class="text-center mb-10">
    <div style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;" class="bg-blue-100 dark:bg-blue-900/30 rounded-full mx-auto mb-6">
      <svg style="width: 40px; height: 40px;" class="text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
      </svg>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">
      Get Your First Build
    </h1>
    <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
      Follow these steps to start tracking deployments
    </p>
  </div>

  <!-- Step 1: Add Secrets -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
    <div class="p-6 sm:p-8">
      <div style="display: flex; align-items: flex-start;">
        <div style="width: 32px; height: 32px; min-width: 32px; display: flex; align-items: center; justify-content: center;" class="bg-blue-600 text-white rounded-full font-semibold mr-4">
          1
        </div>
        <div style="flex: 1;">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
            Add Secrets to GitHub
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            Add these to your repository secrets and variables:
          </p>
          <div class="space-y-3">
            <div class="bg-gray-50 dark:bg-gray-700/50 rounded-xl p-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Repository Secret</span>
              </div>
              <code class="text-sm text-blue-600 dark:text-blue-400 font-mono">GITLAUNCH_API_KEY</code>
              <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
                Use the API key from onboarding, or generate a new one in Settings
              </p>
            </div>
            <div class="bg-gray-50 dark:bg-gray-700/50 rounded-xl p-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Repository Variable</span>
              </div>
              <code class="text-sm text-blue-600 dark:text-blue-400 font-mono">GITLAUNCH_SERVICE_ID</code>
              <div class="mt-2 bg-gray-900 dark:bg-gray-950 rounded-lg p-3 font-mono text-sm text-green-400">
                {{serviceId}}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Step 2: Update CI Workflow -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
    <div class="p-6 sm:p-8">
      <div style="display: flex; align-items: flex-start;">
        <div style="width: 32px; height: 32px; min-width: 32px; display: flex; align-items: center; justify-content: center;" class="bg-blue-600 text-white rounded-full font-semibold mr-4">
          2
        </div>
        <div style="flex: 1;">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
            Update Your CI Workflow
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            Add this step to your GitHub Actions workflow:
          </p>
          <div class="relative">
            <div class="bg-gray-900 dark:bg-gray-950 rounded-xl p-4 font-mono text-sm text-green-400 overflow-x-auto">
              <pre><code>- name: Report build
  uses: gitlaunch/build-reporter@v1
  with:
    api-key: $&#123;&#123; secrets.GITLAUNCH_API_KEY &#125;&#125;
    service-id: $&#123;&#123; vars.GITLAUNCH_SERVICE_ID &#125;&#125;
    action: report-build
    build-id: $&#123;&#123; github.sha &#125;&#125;</code></pre>
            </div>
            <button
              onclick="copyWorkflowCode()"
              class="absolute top-3 right-3 p-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors"
              title="Copy to clipboard"
            >
              <svg id="workflow-copy-icon" style="width: 20px; height: 20px;" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              <svg id="workflow-check-icon" style="width: 20px; height: 20px; display: none;" class="text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Step 3: Push a Commit -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
    <div class="p-6 sm:p-8">
      <div style="display: flex; align-items: flex-start;">
        <div style="width: 32px; height: 32px; min-width: 32px; display: flex; align-items: center; justify-content: center;" class="bg-blue-600 text-white rounded-full font-semibold mr-4">
          3
        </div>
        <div style="flex: 1;">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
            Push a Commit
          </h2>
          <p class="text-gray-600 dark:text-gray-400">
            Your builds will appear here automatically once your CI workflow runs.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Documentation Link -->
  <div class="text-center">
    <a
      href="/docs"
      class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors shadow-lg shadow-blue-600/25"
    >
      <svg style="width: 20px; height: 20px; min-width: 20px;" class="mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
      </svg>
      View Documentation
    </a>
  </div>

  <script>
  function copyWorkflowCode() {
    const code = `- name: Report build
  uses: gitlaunch/build-reporter@v1
  with:
    api-key: \${{ secrets.GITLAUNCH_API_KEY }}
    service-id: \${{ vars.GITLAUNCH_SERVICE_ID }}
    action: report-build
    build-id: \${{ github.sha }}`;
    navigator.clipboard.writeText(code).then(() => {
      const copyIcon = document.getElementById('workflow-copy-icon');
      const checkIcon = document.getElementById('workflow-check-icon');
      copyIcon.style.display = 'none';
      checkIcon.style.display = 'block';
      setTimeout(() => {
        copyIcon.style.display = 'block';
        checkIcon.style.display = 'none';
      }, 2000);
    });
  }
  </script>

  {{else}}
  <!-- State A: No services - show create service CTA -->
  <div class="text-center">
    <div style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;" class="bg-gray-100 dark:bg-gray-700 rounded-full mx-auto mb-6">
      <svg style="width: 40px; height: 40px;" class="text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
      </svg>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
      Create Your First Service
    </h1>
    <p class="text-lg text-gray-600 dark:text-gray-400 mb-8 max-w-md mx-auto">
      A service represents an application or microservice you want to track deployments for.
    </p>
    <a
      href="/services/new"
      class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors shadow-lg shadow-blue-600/25"
    >
      <svg style="width: 20px; height: 20px; min-width: 20px;" class="mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      Create Service
    </a>
  </div>
  {{/if}}
</div>
