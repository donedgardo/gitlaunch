<tr id="{{build.id}}" class="hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
  <td class="px-4 py-3">
    <a
      class="font-mono text-sm text-blue-600 dark:text-blue-400 hover:underline"
      href="{{getBuildCommitLink githubFullName build.id}}"
      target="_blank"
      title="{{build.id}}"
    >
      {{build.id}}
    </a>
  </td>
  {{#each environments as |env|}}
    {{> buildEnvironmentAction
      buildId=../build.id
      env=env
      serviceName=../serviceName
      status=(getStatus ../build env)
    }}
  {{/each}}
</tr>