<tr id="build-{{build.id}}">
  <td>
    <div class="gl-commit">
      <a
        class="gl-sha"
        href="{{getBuildCommitLink repoUrl build.id}}"
        target="_blank"
        title="{{build.id}}"
      >#{{shortSha build.id}}</a>{{#if build.message}}<span class="gl-msg"> · {{build.message}}</span>{{/if}}
    </div>
    {{#if build.createdAt}}
    <div class="gl-when">{{timeAgo build.createdAt}}</div>
    {{/if}}
  </td>
  {{#each build.environments as |env|}}
    {{> buildEnvironmentAction
      buildId=../build.id
      env=env.name
      serviceName=../build.serviceName
      serviceId=../build.serviceId
      status=(getStatus ../build env.name)
      canDispatch=../canDispatch
    }}
  {{/each}}
</tr>