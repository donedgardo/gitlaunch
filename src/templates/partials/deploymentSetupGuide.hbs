<!-- Deployment Workflow Instructions -->
<div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
  <div class="p-6 sm:p-8">
    <div style="display: flex; align-items: flex-start;">
      {{#if stepNumber}}
      <div style="width: 32px; height: 32px; min-width: 32px; display: flex; align-items: center; justify-content: center;" class="bg-blue-600 text-white rounded-full font-semibold mr-4">
        {{stepNumber}}
      </div>
      {{/if}}
      <div style="flex: 1; min-width: 0;">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
          Create Your Deploy Workflow
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          Add a deploy workflow to your repo. This single file works with GitLaunch, your CI pipeline, and manual triggers from the GitHub Actions UI:
        </p>
        <div class="relative -mx-6 sm:mx-0">
            <div class="bg-gray-900 dark:bg-gray-950 sm:rounded-xl p-4 font-mono text-xs text-green-400 overflow-x-auto">
              <pre class="whitespace-pre"><code>name: Deploy

on:
  workflow_dispatch:
    inputs:
      environment:
        description: "Environment to deploy to"
        required: true
        type: choice
        options:
{{#each environments}}
          - {{this.name}}
{{else}}
          - staging
          - prod
{{/each}}
      buildId:
        description: "Build ID (commit SHA)"
        required: false
        type: string
  workflow_call:
    inputs:
      environment:
        required: true
        type: string
      buildId:
        required: false
        type: string

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: $&#123;&#123; inputs.buildId || github.sha &#125;&#125;

      - uses: donedgardo/build-reporter@v2
        with:
          api-key: $&#123;&#123; secrets.GITLAUNCH_API_KEY &#125;&#125;
          service-id: $&#123;&#123; vars.GITLAUNCH_SERVICE_ID &#125;&#125;
          environment: $&#123;&#123; inputs.environment &#125;&#125;
          build-id: $&#123;&#123; inputs.buildId || github.sha &#125;&#125;
          action: deploy

      ####################################
      # Add your deployment steps here   #
      ####################################
      - name: Deploy
        run: echo "Deploy to $&#123;&#123; inputs.environment &#125;&#125;"</code></pre>
            </div>
            <button
              onclick="copyDeployWorkflow()"
              class="absolute top-3 right-3 p-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors"
              title="Copy to clipboard"
            >
              <svg id="deploy-copy-icon" style="width: 20px; height: 20px;" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              <svg id="deploy-check-icon" style="width: 20px; height: 20px; display: none;" class="text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </button>
          </div>

          <!-- Tip: Reuse from CI -->
          <div class="mt-6 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-4">
            <div style="display: flex; align-items: flex-start;">
              <svg style="width: 20px; height: 20px; min-width: 20px;" class="text-blue-600 dark:text-blue-400 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div>
                <h3 class="font-semibold text-blue-800 dark:text-blue-200 mb-1">Auto-deploy from CI</h3>
                <p class="text-sm text-blue-700 dark:text-blue-300 mb-3">
                  Want to auto-deploy after your tests pass? Add this to your CI workflow:
                </p>
                <div class="bg-gray-900 dark:bg-gray-950 rounded-lg p-3 font-mono text-xs text-green-400 overflow-x-auto">
                  <pre class="whitespace-pre"><code>  deploy:
    needs: [tests]
    if: github.ref == 'refs/heads/main'
    uses: ./.github/workflows/deploy.yml
    with:
      environment: {{#if environments.[0]}}{{environments.[0].name}}{{else}}staging{{/if}}
      buildId: $&#123;&#123; github.sha &#125;&#125;</code></pre>
                </div>
              </div>
            </div>
          </div>

          <!-- Status Reference -->
          <div class="mt-6">
            <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-3">Deployment Status Values</h3>
            <div class="flex flex-wrap gap-2">
              <div class="inline-flex items-center space-x-2 px-3 py-1.5 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-900 dark:bg-blue-900 dark:text-blue-100">
                  deploying
                </span>
                <span class="text-xs text-gray-500 dark:text-gray-400">In progress</span>
              </div>
              <div class="inline-flex items-center space-x-2 px-3 py-1.5 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-900 dark:bg-green-900 dark:text-green-100">
                  deployed
                </span>
                <span class="text-xs text-gray-500 dark:text-gray-400">Success</span>
              </div>
              <div class="inline-flex items-center space-x-2 px-3 py-1.5 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-900 dark:bg-red-900 dark:text-red-100">
                  error
                </span>
                <span class="text-xs text-gray-500 dark:text-gray-400">Failed</span>
              </div>
              <div class="inline-flex items-center space-x-2 px-3 py-1.5 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-900 dark:bg-gray-700 dark:text-gray-100">
                  cancelled
                </span>
                <span class="text-xs text-gray-500 dark:text-gray-400">Aborted</span>
              </div>
            </div>
          </div>
      </div>
    </div>
  </div>
</div>

<script>
function copyDeployWorkflow() {
  const environments = [{{#each environments}}"{{this.name}}"{{#unless @last}}, {{/unless}}{{/each}}];
  const envOptions = environments.length > 0
    ? environments.map(e => `          - ${e}`).join('\n')
    : `          - staging
          - prod`;

  const code = `name: Deploy

on:
  workflow_dispatch:
    inputs:
      environment:
        description: "Environment to deploy to"
        required: true
        type: choice
        options:
${envOptions}
      buildId:
        description: "Build ID (commit SHA)"
        required: false
        type: string
  workflow_call:
    inputs:
      environment:
        required: true
        type: string
      buildId:
        required: false
        type: string

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: \$\{{ inputs.buildId || github.sha }}

      - uses: donedgardo/build-reporter@v2
        with:
          api-key: \$\{{ secrets.GITLAUNCH_API_KEY }}
          service-id: \$\{{ vars.GITLAUNCH_SERVICE_ID }}
          environment: \$\{{ inputs.environment }}
          build-id: \$\{{ inputs.buildId || github.sha }}
          action: deploy

      ####################################
      # Add your deployment steps here   #
      ####################################
      - name: Deploy
        run: echo "Deploy to \$\{{ inputs.environment }}"`;
  navigator.clipboard.writeText(code).then(() => {
    const copyIcon = document.getElementById('deploy-copy-icon');
    const checkIcon = document.getElementById('deploy-check-icon');
    copyIcon.style.display = 'none';
    checkIcon.style.display = 'block';
    setTimeout(() => {
      copyIcon.style.display = 'block';
      checkIcon.style.display = 'none';
    }, 2000);
  });
}
</script>
