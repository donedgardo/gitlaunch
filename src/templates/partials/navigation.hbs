<nav id="main-navigation" class="flex items-center justify-between border-b border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900" hx-swap-oob="true">
  <ul class="flex flex-row flex-wrap">
    {{#each services as |serviceName|}}
      <li class="flex items-center">
        <a
          href="/dashboard/{{serviceName}}"
          hx-get="/dashboard/{{serviceName}}"
          hx-target="#build-table"
          hx-push-url="true"
          class="inline-block px-4 py-3 text-sm font-medium transition-colors {{#if (eq serviceName ../activeService)}}text-blue-600 dark:text-blue-400 border-b-2 border-blue-600 dark:border-blue-400{{else}}text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 border-b-2 border-transparent hover:border-gray-300 dark:hover:border-gray-600{{/if}}"
        >
          {{serviceName}}
        </a>
        {{#if (eq serviceName ../activeService)}}
        <a
          href="/services/{{../serviceId}}/settings"
          class="inline-block px-2 py-3 text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 transition-colors border-b-2 border-transparent"
          title="Settings"
          aria-label="Settings"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </a>
        {{/if}}
      </li>
    {{/each}}
    <li>
      <a
        href="/services/new"
        class="inline-block px-4 py-3 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 border-b-2 border-transparent hover:border-gray-300 dark:hover:border-gray-600 transition-colors"
        title="Create new service"
        aria-label="Create new service"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
      </a>
    </li>
  </ul>
  <a
    href="/logout"
    class="mr-4 px-3 py-1.5 text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
  >
    Logout
  </a>
</nav>