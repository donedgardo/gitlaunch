<td
  id="{{serviceName}}-{{buildId}}-{{env}}"
  sse-swap="update:{{serviceName}}-{{buildId}}-{{env}}"
  {{#if isOobSwap}}hx-swap-oob="outerHTML"{{/if}}
  class="px-4 py-3 text-center"
>
  {{#if (showDeployButton status) }}
    <button
      hx-patch="/services/{{serviceId}}/builds/{{buildId}}/deploy/{{env}}"
      hx-target="#{{serviceName}}-{{buildId}}-{{env}}"
      class="px-3 py-1.5 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 transition-colors"
    >
      Deploy
    </button>
  {{else}}
    <span class="{{getStatusBadgeClass status}}">{{status}}</span>
  {{/if}}
</td>