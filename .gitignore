# Dependencies
# No trailing slash: worktrees symlink node_modules, and `node_modules/`
# does not match a symlink, so it would get committed and break CI's install.
node_modules

# Build output
dist/

# Environment variables
.env
.env.local
.env.*.local

# Private keys
*.pem

# IDE/Editors
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/

# TypeScript
*.tsbuildinfo

# Generated CSS (Tailwind)
src/public/css/main.css

# Claude — local settings and worktrees stay out, shared team skills ship.
.claude/*
!.claude/skills/
test-results/
playwright-report/
