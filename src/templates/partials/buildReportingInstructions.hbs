{{!-- Build Reporting Instructions — plain curl, no action to maintain.

     Requires: apiUrl — the public URL of THIS instance. A self-hosted install
     is not the hosted service, and a snippet naming the wrong host sends the
     customer's own API key somewhere they never meant it to go.
     Optional: idPrefix (for unique element IDs), stepNumber.

     The YAML comes from services/setup/setupSnippets.ts via the setupSnippet
     helper — the same generator /setup-snippets serves. Never paste a copy of
     it here; that is how the two drifted apart. --}}
<div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
  <div class="p-6 sm:p-8">
    <div style="display: flex; align-items: flex-start;">
      {{#if stepNumber}}
      <div style="width: 32px; height: 32px; min-width: 32px; display: flex; align-items: center; justify-content: center;" class="bg-blue-600 text-white rounded-full font-semibold mr-4">
        {{stepNumber}}
      </div>
      {{/if}}
      <div style="flex: 1; min-width: 0;">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
          Set Up Your CI Workflow
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          Add this step to your GitHub Actions workflow to report each build to GitLaunch:
        </p>
        <div class="relative">
          <div class="bg-gray-900 dark:bg-gray-950 rounded-xl p-4 font-mono text-xs text-green-400 overflow-x-auto">
            <pre class="whitespace-pre"><code id="{{idPrefix}}gh_curl_build">{{setupSnippet "buildReport.github" apiUrl=apiUrl}}</code></pre>
          </div>
          <button
            onclick="copyReportSnippet('{{idPrefix}}gh_curl_build', '{{idPrefix}}gh_curl_build_copy', '{{idPrefix}}gh_curl_build_check')"
            class="absolute top-3 right-3 p-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors"
            title="Copy to clipboard"
          >
            <svg id="{{idPrefix}}gh_curl_build_copy" style="width: 20px; height: 20px;" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
            <svg id="{{idPrefix}}gh_curl_build_check" style="width: 20px; height: 20px; display: none;" class="text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </button>
        </div>
        <div class="mt-3 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-3">
          <p class="text-xs text-blue-700 dark:text-blue-300">
            Add a repository secret <code class="bg-blue-100 dark:bg-blue-900/40 px-1 rounded">GITLAUNCH_API_KEY</code>
            and a repository variable <code class="bg-blue-100 dark:bg-blue-900/40 px-1 rounded">GITLAUNCH_SERVICE_ID</code>
            (see above). The step only runs on pushes to the branch named in its
            <code class="bg-blue-100 dark:bg-blue-900/40 px-1 rounded">if:</code> guard.
            It sends the commit message too, so each build is easy to spot on your dashboard,
            and the commit time, so lead time measures commit-to-live rather than starting
            when CI got around to telling us.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function copyReportSnippet(codeId, copyIconId, checkIconId) {
  var code = document.getElementById(codeId).textContent;
  var copyIcon = document.getElementById(copyIconId);
  var checkIcon = document.getElementById(checkIconId);
  navigator.clipboard.writeText(code).then(function () {
    copyIcon.style.display = 'none';
    checkIcon.style.display = 'block';
    setTimeout(function () {
      copyIcon.style.display = 'block';
      checkIcon.style.display = 'none';
    }, 2000);
  });
}
</script>
