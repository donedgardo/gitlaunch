<td
  id="{{serviceName}}-{{buildId}}-{{env}}"
  {{!-- Names the cell's environment for the phone layout, where the column
        header is gone and each line labels itself from this attribute. --}}
  data-env="{{env}}"
  sse-swap="update:{{serviceName}}-{{buildId}}-{{env}}"
  {{#if isOobSwap}}hx-swap-oob="outerHTML"{{/if}}
  {{!-- A cell only flashes when it is swapped in mid-change (deploy, cancel,
        rollback) — a full board render is a settled view, not an event. --}}
  class="gl-env-cell{{#if isOobSwap}} gl-just-changed{{/if}}"
>
  {{#if canDispatch}}
    {{#if (showDeployButton status) }}
      {{!-- The click answers at once: the button turns into the dispatching
            pill and the progress bar starts under it, before the server has
            replied. The swapped-in cell then carries the same bar. --}}
      <div class="gl-env-state">
        <button
          hx-patch="/services/{{serviceId}}/builds/{{buildId}}/deploy/{{env}}"
          hx-target="#{{serviceName}}-{{buildId}}-{{env}}"
          hx-disabled-elt="this"
          hx-on::before-request="this.innerHTML='<span class=\'gl-dot\'></span>dispatching'; this.className='pill pill-pending'; this.insertAdjacentHTML('afterend', '<div class=\'gl-cprog gl-cprog-dispatching\' aria-hidden=\'true\'><div class=\'gl-cprog-fill\'></div></div>');"
          class="cbtn"
        >
          Deploy
        </button>
      </div>
    {{else}}
      {{!-- While a deploy is in flight (dispatching or deploying) a progress
            bar runs under the pill — the board's version of the landing page
            toy's .cprog. It is decorative: the pill already says the status. --}}
      <div class="gl-env-state">
      <div class="inline-flex items-center gap-2">
        <span class="{{getStatusBadgeClass status}}">{{#if (showStatusDot status)}}<span class="gl-dot"></span>{{/if}}{{status}}</span>
        {{#if (showDeployedAt status deployedAt)}}<span class="gl-when-env">{{timeAgo deployedAt}}</span>{{/if}}{{#if (showDeployedAt status deployedBy)}}<span class="gl-who-env" title="Shipped by {{deployedBy}}">by {{deployedBy}}</span>{{/if}}
        {{#if (canCancel status)}}
          <button
            hx-delete="/services/{{serviceId}}/builds/{{buildId}}/deploy/{{env}}"
            hx-target="#{{serviceName}}-{{buildId}}-{{env}}"
            hx-disabled-elt="this"
            hx-on::before-request="this.closest('div').querySelector('span').textContent='cancelling';"
            class="gl-icon-btn"
            title="Cancel deployment"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        {{/if}}
        {{#if (canRedeploy status)}}
          <button
            hx-patch="/services/{{serviceId}}/builds/{{buildId}}/deploy/{{env}}"
            hx-target="#{{serviceName}}-{{buildId}}-{{env}}"
            hx-disabled-elt="this"
            hx-on::before-request="var row=this.closest('div'); row.innerHTML='<span class=\'pill pill-pending\'><span class=\'gl-dot\'></span>dispatching</span>'; row.insertAdjacentHTML('afterend', '<div class=\'gl-cprog gl-cprog-dispatching\' aria-hidden=\'true\'><div class=\'gl-cprog-fill\'></div></div>');"
            class="gl-icon-btn"
            title="Redeploy"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
          </button>
        {{/if}}
      </div>
      {{#if (canCancel status)}}<div class="gl-cprog gl-cprog-{{status}}" aria-hidden="true"><div class="gl-cprog-fill"></div></div>{{/if}}
      </div>
    {{/if}}
  {{else}}
    {{#if status}}
      <div class="gl-env-state">
        <span class="inline-flex items-center gap-2">
          <span class="{{getStatusBadgeClass status}}">{{#if (showStatusDot status)}}<span class="gl-dot"></span>{{/if}}{{status}}</span>
          {{#if (showDeployedAt status deployedAt)}}<span class="gl-when-env">{{timeAgo deployedAt}}</span>{{/if}}{{#if (showDeployedAt status deployedBy)}}<span class="gl-who-env" title="Shipped by {{deployedBy}}">by {{deployedBy}}</span>{{/if}}
        </span>
        {{#if (canCancel status)}}<div class="gl-cprog gl-cprog-{{status}}" aria-hidden="true"><div class="gl-cprog-fill"></div></div>{{/if}}
      </div>
    {{else}}
      <span class="gl-empty-env">—</span>
    {{/if}}
  {{/if}}
</td>
