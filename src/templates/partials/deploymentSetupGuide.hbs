<div class="max-w-4xl mx-auto px-4 py-16">
  <!-- State: Builds exist but no deployments configured -->
  <div class="text-center mb-10">
    <div style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center;" class="bg-amber-100 dark:bg-amber-900/30 rounded-full mx-auto mb-6">
      <svg style="width: 40px; height: 40px;" class="text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
      </svg>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">
      Configure Deployment Workflow
    </h1>
    <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
      Your builds are being tracked! Now let's set up the deployment workflow.
    </p>
  </div>

  <!-- Step 1: Select Workflow -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
    <div class="p-6 sm:p-8">
      <div style="display: flex; align-items: flex-start;">
        <div style="width: 32px; height: 32px; min-width: 32px; display: flex; align-items: center; justify-content: center;" class="bg-blue-600 text-white rounded-full font-semibold mr-4 flex-shrink-0">
          1
        </div>
        <div style="flex: 1; min-width: 0;">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
            Select Deployment Workflow
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            Choose the GitHub Actions workflow that handles deployments:
          </p>
          <form action="/services/{{serviceId}}/configure-workflow" method="POST">
            <div class="space-y-4">
              <div>
                <label for="workflowFile" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Workflow File
                </label>
                <select
                  id="workflowFile"
                  name="workflowFile"
                  class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  hx-get="/services/{{serviceId}}/workflows"
                  hx-trigger="load"
                  hx-swap="innerHTML"
                >
                  <option value="">Loading workflows...</option>
                </select>
              </div>

              <button
                type="submit"
                class="w-full px-6 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors shadow-lg shadow-blue-600/25"
              >
                Save Configuration
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Step 2: Create Deploy Workflow -->
  <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-lg overflow-hidden mb-6">
    <div class="p-6 sm:p-8">
      <div style="display: flex; align-items: flex-start;">
        <div style="width: 32px; height: 32px; min-width: 32px; display: flex; align-items: center; justify-content: center;" class="bg-gray-400 text-white rounded-full font-semibold mr-4 flex-shrink-0">
          2
        </div>
        <div style="flex: 1; min-width: 0;">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
            Create Your Deploy Workflow
          </h2>
          <p class="text-gray-600 dark:text-gray-400 mb-4">
            Add a deploy workflow to your repo. This single file works with GitLaunch, your CI pipeline, and manual triggers from the GitHub Actions UI:
          </p>
          <div class="relative -mx-6 sm:mx-0">
            <div class="bg-gray-900 dark:bg-gray-950 sm:rounded-xl p-4 font-mono text-xs text-green-400 overflow-x-auto">
              <pre class="whitespace-pre"><code>name: Deploy

on:
  workflow_dispatch:
    inputs:
      environment:
        description: "Environment to deploy to"
        required: true
        type: choice
        options:
          - dev
          - staging
          - production
      buildId:
        description: "Build ID (commit SHA)"
        required: false
        type: string
      serviceId:
        description: "GitLaunch Service ID"
        required: false
        type: string
  workflow_call:
    inputs:
      environment:
        required: true
        type: string
      buildId:
        required: false
        type: string
      serviceId:
        required: false
        type: string
    secrets:
      GITLAUNCH_API_KEY:
        required: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    env:
      ENVIRONMENT: $&#123;&#123; inputs.environment &#125;&#125;
      BUILD_ID: $&#123;&#123; inputs.buildId || github.sha &#125;&#125;
      SERVICE_ID: $&#123;&#123; inputs.serviceId &#125;&#125;
    steps:
      - uses: actions/checkout@v4
        with:
          ref: $&#123;&#123; env.BUILD_ID &#125;&#125;

      # Report: Deployment started
      - name: Report deploying
        if: env.SERVICE_ID != ''
        uses: donedgardo/build-reporter@v1
        with:
          api-key: $&#123;&#123; secrets.GITLAUNCH_API_KEY &#125;&#125;
          service-id: $&#123;&#123; env.SERVICE_ID &#125;&#125;
          action: update-status
          build-id: $&#123;&#123; env.BUILD_ID &#125;&#125;
          environment: $&#123;&#123; env.ENVIRONMENT &#125;&#125;
          status: deploying

      ####################################
      # Add your deployment steps here   #
      ####################################
      - name: Deploy
        run: echo "Deploy to $&#123;&#123; env.ENVIRONMENT &#125;&#125;"

      # Report: Deployment succeeded
      - name: Report deployed
        if: success() &amp;&amp; env.SERVICE_ID != ''
        uses: donedgardo/build-reporter@v1
        with:
          api-key: $&#123;&#123; secrets.GITLAUNCH_API_KEY &#125;&#125;
          service-id: $&#123;&#123; env.SERVICE_ID &#125;&#125;
          action: update-status
          build-id: $&#123;&#123; env.BUILD_ID &#125;&#125;
          environment: $&#123;&#123; env.ENVIRONMENT &#125;&#125;
          status: deployed

      # Report: Deployment failed
      - name: Report error
        if: failure() &amp;&amp; env.SERVICE_ID != ''
        uses: donedgardo/build-reporter@v1
        with:
          api-key: $&#123;&#123; secrets.GITLAUNCH_API_KEY &#125;&#125;
          service-id: $&#123;&#123; env.SERVICE_ID &#125;&#125;
          action: update-status
          build-id: $&#123;&#123; env.BUILD_ID &#125;&#125;
          environment: $&#123;&#123; env.ENVIRONMENT &#125;&#125;
          status: error

      # Report: Deployment cancelled
      - name: Report cancelled
        if: cancelled() &amp;&amp; env.SERVICE_ID != ''
        uses: donedgardo/build-reporter@v1
        with:
          api-key: $&#123;&#123; secrets.GITLAUNCH_API_KEY &#125;&#125;
          service-id: $&#123;&#123; env.SERVICE_ID &#125;&#125;
          action: update-status
          build-id: $&#123;&#123; env.BUILD_ID &#125;&#125;
          environment: $&#123;&#123; env.ENVIRONMENT &#125;&#125;
          status: cancelled</code></pre>
            </div>
            <button
              onclick="copyDeployWorkflow()"
              class="absolute top-3 right-3 p-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors"
              title="Copy to clipboard"
            >
              <svg id="deploy-copy-icon" style="width: 20px; height: 20px;" class="text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              <svg id="deploy-check-icon" style="width: 20px; height: 20px; display: none;" class="text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </button>
          </div>

          <!-- Tip: Reuse from CI -->
          <div class="mt-6 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-4">
            <div style="display: flex; align-items: flex-start;">
              <svg style="width: 20px; height: 20px; min-width: 20px;" class="text-blue-600 dark:text-blue-400 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div>
                <h3 class="font-semibold text-blue-800 dark:text-blue-200 mb-1">Auto-deploy from CI</h3>
                <p class="text-sm text-blue-700 dark:text-blue-300 mb-3">
                  Want to auto-deploy after your tests pass? Add this to your CI workflow:
                </p>
                <div class="bg-gray-900 dark:bg-gray-950 rounded-lg p-3 font-mono text-xs text-green-400 overflow-x-auto">
                  <pre class="whitespace-pre"><code>  deploy:
    needs: [tests]
    if: github.ref == 'refs/heads/main'
    uses: ./.github/workflows/deploy.yml
    with:
      environment: dev
      buildId: $&#123;&#123; github.sha &#125;&#125;
      serviceId: $&#123;&#123; vars.GITLAUNCH_SERVICE_ID &#125;&#125;
    secrets: inherit</code></pre>
                </div>
              </div>
            </div>
          </div>

          <!-- Status Reference -->
          <div class="mt-6">
            <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-3">Deployment Status Values</h3>
            <div class="flex flex-wrap gap-2">
              <div class="inline-flex items-center space-x-2 px-3 py-1.5 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-900 dark:bg-blue-900 dark:text-blue-100">
                  deploying
                </span>
                <span class="text-xs text-gray-500 dark:text-gray-400">In progress</span>
              </div>
              <div class="inline-flex items-center space-x-2 px-3 py-1.5 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-900 dark:bg-green-900 dark:text-green-100">
                  deployed
                </span>
                <span class="text-xs text-gray-500 dark:text-gray-400">Success</span>
              </div>
              <div class="inline-flex items-center space-x-2 px-3 py-1.5 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-900 dark:bg-red-900 dark:text-red-100">
                  error
                </span>
                <span class="text-xs text-gray-500 dark:text-gray-400">Failed</span>
              </div>
              <div class="inline-flex items-center space-x-2 px-3 py-1.5 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-900 dark:bg-gray-700 dark:text-gray-100">
                  cancelled
                </span>
                <span class="text-xs text-gray-500 dark:text-gray-400">Aborted</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Documentation Link -->
  <div class="text-center">
    <a
      href="/docs"
      class="inline-flex items-center px-6 py-3 text-blue-600 dark:text-blue-400 font-semibold hover:underline"
    >
      <svg style="width: 20px; height: 20px; min-width: 20px;" class="mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
      </svg>
      View Documentation
    </a>
  </div>
</div>

<script>
function copyDeployWorkflow() {
  const code = `name: Deploy

on:
  workflow_dispatch:
    inputs:
      environment:
        description: "Environment to deploy to"
        required: true
        type: choice
        options:
          - dev
          - staging
          - production
      buildId:
        description: "Build ID (commit SHA)"
        required: false
        type: string
      serviceId:
        description: "GitLaunch Service ID"
        required: false
        type: string
  workflow_call:
    inputs:
      environment:
        required: true
        type: string
      buildId:
        required: false
        type: string
      serviceId:
        required: false
        type: string
    secrets:
      GITLAUNCH_API_KEY:
        required: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    env:
      ENVIRONMENT: \$\{{ inputs.environment }}
      BUILD_ID: \$\{{ inputs.buildId || github.sha }}
      SERVICE_ID: \$\{{ inputs.serviceId }}
    steps:
      - uses: actions/checkout@v4
        with:
          ref: \$\{{ env.BUILD_ID }}

      # Report: Deployment started
      - name: Report deploying
        if: env.SERVICE_ID != ''
        uses: donedgardo/build-reporter@v1
        with:
          api-key: \$\{{ secrets.GITLAUNCH_API_KEY }}
          service-id: \$\{{ env.SERVICE_ID }}
          action: update-status
          build-id: \$\{{ env.BUILD_ID }}
          environment: \$\{{ env.ENVIRONMENT }}
          status: deploying

      ####################################
      # Add your deployment steps here   #
      ####################################
      - name: Deploy
        run: echo "Deploy to \$\{{ env.ENVIRONMENT }}"

      # Report: Deployment succeeded
      - name: Report deployed
        if: success() && env.SERVICE_ID != ''
        uses: donedgardo/build-reporter@v1
        with:
          api-key: \$\{{ secrets.GITLAUNCH_API_KEY }}
          service-id: \$\{{ env.SERVICE_ID }}
          action: update-status
          build-id: \$\{{ env.BUILD_ID }}
          environment: \$\{{ env.ENVIRONMENT }}
          status: deployed

      # Report: Deployment failed
      - name: Report error
        if: failure() && env.SERVICE_ID != ''
        uses: donedgardo/build-reporter@v1
        with:
          api-key: \$\{{ secrets.GITLAUNCH_API_KEY }}
          service-id: \$\{{ env.SERVICE_ID }}
          action: update-status
          build-id: \$\{{ env.BUILD_ID }}
          environment: \$\{{ env.ENVIRONMENT }}
          status: error

      # Report: Deployment cancelled
      - name: Report cancelled
        if: cancelled() && env.SERVICE_ID != ''
        uses: donedgardo/build-reporter@v1
        with:
          api-key: \$\{{ secrets.GITLAUNCH_API_KEY }}
          service-id: \$\{{ env.SERVICE_ID }}
          action: update-status
          build-id: \$\{{ env.BUILD_ID }}
          environment: \$\{{ env.ENVIRONMENT }}
          status: cancelled`;
  navigator.clipboard.writeText(code).then(() => {
    const copyIcon = document.getElementById('deploy-copy-icon');
    const checkIcon = document.getElementById('deploy-check-icon');
    copyIcon.style.display = 'none';
    checkIcon.style.display = 'block';
    setTimeout(() => {
      copyIcon.style.display = 'block';
      checkIcon.style.display = 'none';
    }, 2000);
  });
}
</script>
